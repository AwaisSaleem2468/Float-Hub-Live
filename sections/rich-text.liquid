{{ 'section-rich-text.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #RichText-{{ section.id }} {
    --rt-bg: {{ section.settings.background_color | default: '#070D16' }};
    --rt-heading: {{ section.settings.heading_color | default: '#FFFFFF' }};
    --rt-caption: {{ section.settings.caption_color | default: '#0DAAEF' }};
    --rt-text: {{ section.settings.text_color | default: '#A8B0BD' }};
    --rt-link: {{ section.settings.link_color | default: '#0DAAEF' }};
    --rt-btn-text: {{ section.settings.button_text_color | default: '#FFFFFF' }};
    --rt-btn-secondary-text: {{ section.settings.button_secondary_text_color | default: '#FFFFFF' }};
    --rt-btn-secondary-border: {{ section.settings.button_secondary_border_color | default: '#FFFFFF' }};
    --rt-heading-size: {{ section.settings.heading_size | default: 40 }}px;
    --rt-heading-size-mobile: {{ section.settings.heading_size_mobile | default: 28 }}px;
    --rt-caption-size: {{ section.settings.caption_size | default: 14 }}px;
    --rt-caption-size-mobile: {{ section.settings.caption_size_mobile | default: 13 }}px;
    --rt-text-size: {{ section.settings.text_size | default: 16 }}px;
    --rt-text-size-mobile: {{ section.settings.text_size_mobile | default: 15 }}px;
    --rt-button-size: {{ section.settings.button_size | default: 15 }}px;
    --rt-button-radius: {{ section.settings.button_radius | default: 40 }}px;
    background-color: var(--rt-bg);
    color: var(--rt-text);
    {% if section.settings.show_border_top %}
      border-top: {{ section.settings.border_thickness | default: 1 }}px solid {{ section.settings.border_color | default: '#243041' }};
    {% endif %}
    {% if section.settings.show_border_bottom %}
      border-bottom: {{ section.settings.border_thickness | default: 1 }}px solid {{ section.settings.border_color | default: '#243041' }};
    {% endif %}
  }

  #RichText-{{ section.id }} .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  #RichText-{{ section.id }} .rich-text {
    background: transparent;
  }

  #RichText-{{ section.id }} .rich-text__blocks {
    width: 100%;
    max-width: {{ section.settings.content_max_width | default: 800 }}px;
  }

  #RichText-{{ section.id }} .rich-text__heading {
    color: var(--rt-heading);
    font-size: var(--rt-heading-size-mobile);
    line-height: 1.2;
  }

  #RichText-{{ section.id }} .rich-text__caption {
    color: var(--rt-caption);
    font-size: var(--rt-caption-size-mobile);
  }

  #RichText-{{ section.id }} .rich-text__text {
    color: var(--rt-text);
    font-size: var(--rt-text-size-mobile);
    line-height: 1.6;
  }

  #RichText-{{ section.id }} .rich-text__text p,
  #RichText-{{ section.id }} .rich-text__text li {
    color: inherit;
  }

  #RichText-{{ section.id }} .rich-text__text a {
    color: var(--rt-link);
  }

  #RichText-{{ section.id }} .rich-text__text strong,
  #RichText-{{ section.id }} .rich-text__text b {
    color: var(--rt-heading);
  }

  #RichText-{{ section.id }} .rich-text__buttons {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
    width: auto;
    max-width: 100%;
  }

  #RichText-{{ section.id }} .rich-text__buttons--multiple > * {
    flex: 0 0 auto;
    flex-grow: 0;
    min-width: 0;
    width: auto;
  }

  #RichText-{{ section.id }} .rich-text__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: auto;
    min-height: 4.4rem;
    padding: 1rem 2rem;
    border-radius: var(--rt-button-radius);
    border: 1px solid transparent;
    font-family: var(--font-body-family);
    font-size: var(--rt-button-size);
    font-weight: 600;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    white-space: normal;
    transition: transform 0.2s ease, filter 0.2s ease, background-color 0.2s ease, border-color 0.2s ease;
    cursor: pointer;
  }

  #RichText-{{ section.id }} .rich-text__btn:hover {
    transform: translateY(-1px);
  }

  #RichText-{{ section.id }} .rich-text__btn--primary {
    background: linear-gradient(to right, #3b82f6, #22d3ee);
    color: var(--rt-btn-text);
    border-color: transparent;
  }

  #RichText-{{ section.id }} .rich-text__btn--primary:hover {
    filter: brightness(1.05);
  }

  #RichText-{{ section.id }} .rich-text__btn--secondary {
    background: transparent;
    color: var(--rt-btn-secondary-text);
    border-color: var(--rt-btn-secondary-border);
  }

  #RichText-{{ section.id }} .rich-text__btn--secondary:hover {
    background: rgba(255, 255, 255, 0.06);
    border-color: color-mix(in srgb, var(--rt-btn-secondary-border) 80%, #ffffff);
  }

  @media screen and (min-width: 750px) {
    #RichText-{{ section.id }} .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    #RichText-{{ section.id }} .rich-text__heading {
      font-size: var(--rt-heading-size);
    }

    #RichText-{{ section.id }} .rich-text__caption {
      font-size: var(--rt-caption-size);
    }

    #RichText-{{ section.id }} .rich-text__text {
      font-size: var(--rt-text-size);
    }
  }

  @media screen and (max-width: 749px) {
    #RichText-{{ section.id }} .rich-text__buttons {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      justify-content: center;
      max-width: 100%;
    }

    #RichText-{{ section.id }} .rich-text__buttons--multiple > * {
      flex: 0 0 auto;
      width: auto;
    }

    #RichText-{{ section.id }} .rich-text__btn {
      width: auto;
    }
  }
{%- endstyle -%}

<section id="RichText-{{ section.id }}" class="rich-text-section">
  <div class="isolate{% unless section.settings.full_width %} page-width{% endunless %}">
    <div class="rich-text content-container{% if section.settings.full_width %} rich-text--full-width content-container--full-width{% endif %} section-{{ section.id }}-padding">
      <div class="rich-text__wrapper rich-text__wrapper--{{ section.settings.desktop_content_position }}{% if section.settings.full_width %} page-width{% endif %}">
        <div class="rich-text__blocks {{ section.settings.content_alignment }}">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'heading' -%}
                <h2
                  class="rich-text__heading rte inline-richtext{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                  {{ block.shopify_attributes }}
                  {% if settings.animations_reveal_on_scroll %}
                    data-cascade
                    style="--animation-order: {{ forloop.index }};"
                  {% endif %}
                >
                  {{ block.settings.heading }}
                </h2>
              {%- when 'caption' -%}
                <p
                  class="rich-text__caption {{ block.settings.text_style }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                  {{ block.shopify_attributes }}
                  {% if settings.animations_reveal_on_scroll %}
                    data-cascade
                    style="--animation-order: {{ forloop.index }};"
                  {% endif %}
                >
                  {{ block.settings.caption | escape }}
                </p>
              {%- when 'text' -%}
                <div
                  class="rich-text__text rte{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                  {{ block.shopify_attributes }}
                  {% if settings.animations_reveal_on_scroll %}
                    data-cascade
                    style="--animation-order: {{ forloop.index }};"
                  {% endif %}
                >
                  {{ block.settings.text }}
                </div>
              {%- when 'button' -%}
                {%- liquid
                  assign button_count = 0
                  if block.settings.button_label != blank
                    assign button_count = button_count | plus: 1
                  endif
                  if block.settings.button_label_2 != blank
                    assign button_count = button_count | plus: 1
                  endif
                  if block.settings.button_label_3 != blank
                    assign button_count = button_count | plus: 1
                  endif
                -%}
                <div
                  class="rich-text__buttons{% if button_count > 1 %} rich-text__buttons--multiple{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                  {{ block.shopify_attributes }}
                  {% if settings.animations_reveal_on_scroll %}
                    data-cascade
                    style="--animation-order: {{ forloop.index }};"
                  {% endif %}
                >
                  {%- if block.settings.button_label != blank -%}
                    {%- capture button_href_1 -%}
                      {%- render 'product-cta-url',
                        link: block.settings.button_link,
                        product: block.settings.button_product,
                        redirect_to_checkout: block.settings.button_redirect_checkout
                      -%}
                    {%- endcapture -%}
                    {%- assign button_href_1 = button_href_1 | strip -%}
                    <a
                      {% if button_href_1 == blank %}
                        role="link" aria-disabled="true"
                      {% else %}
                        href="{{ button_href_1 }}"
                      {% endif %}
                      class="rich-text__btn{% if block.settings.button_style_secondary %} rich-text__btn--secondary{% else %} rich-text__btn--primary{% endif %}"
                    >
                      {{- block.settings.button_label | escape -}}
                    </a>
                  {%- endif -%}
                  {%- if block.settings.button_label_2 != blank -%}
                    {%- capture button_href_2 -%}
                      {%- render 'product-cta-url',
                        link: block.settings.button_link_2,
                        product: block.settings.button_product_2,
                        redirect_to_checkout: block.settings.button_redirect_checkout_2
                      -%}
                    {%- endcapture -%}
                    {%- assign button_href_2 = button_href_2 | strip -%}
                    <a
                      {% if button_href_2 == blank %}
                        role="link" aria-disabled="true"
                      {% else %}
                        href="{{ button_href_2 }}"
                      {% endif %}
                      class="rich-text__btn{% if block.settings.button_style_secondary_2 %} rich-text__btn--secondary{% else %} rich-text__btn--primary{% endif %}"
                    >
                      {{- block.settings.button_label_2 | escape -}}
                    </a>
                  {%- endif -%}
                  {%- if block.settings.button_label_3 != blank -%}
                    {%- capture button_href_3 -%}
                      {%- render 'product-cta-url',
                        link: block.settings.button_link_3,
                        product: block.settings.button_product_3,
                        redirect_to_checkout: block.settings.button_redirect_checkout_3
                      -%}
                    {%- endcapture -%}
                    {%- assign button_href_3 = button_href_3 | strip -%}
                    <a
                      {% if button_href_3 == blank %}
                        role="link" aria-disabled="true"
                      {% else %}
                        href="{{ button_href_3 }}"
                      {% endif %}
                      class="rich-text__btn{% if block.settings.button_style_secondary_3 %} rich-text__btn--secondary{% else %} rich-text__btn--primary{% endif %}"
                    >
                      {{- block.settings.button_label_3 | escape -}}
                    </a>
                  {%- endif -%}
                </div>
            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.rich-text.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "desktop_content_position",
      "options": [
        {
          "value": "left",
          "label": "t:sections.rich-text.settings.desktop_content_position.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.rich-text.settings.desktop_content_position.options__2.label"
        },
        {
          "value": "right",
          "label": "t:sections.rich-text.settings.desktop_content_position.options__3.label"
        }
      ],
      "default": "center",
      "label": "t:sections.rich-text.settings.desktop_content_position.label"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "options": [
        {
          "value": "left",
          "label": "t:sections.rich-text.settings.content_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.rich-text.settings.content_alignment.options__2.label"
        },
        {
          "value": "right",
          "label": "t:sections.rich-text.settings.content_alignment.options__3.label"
        }
      ],
      "default": "center",
      "label": "t:sections.rich-text.settings.content_alignment.label"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "default": true,
      "label": "t:sections.rich-text.settings.full_width.label"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "min": 400,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "label": "Content max width",
      "default": 800,
      "info": "Controls the inner width of heading, text, and buttons."
    },
    {
      "type": "header",
      "content": "Borders"
    },
    {
      "type": "checkbox",
      "id": "show_border_top",
      "label": "Show top border",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_border_bottom",
      "label": "Show bottom border",
      "default": false
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#243041"
    },
    {
      "type": "range",
      "id": "border_thickness",
      "min": 1,
      "max": 8,
      "step": 1,
      "unit": "px",
      "label": "Border thickness",
      "default": 1
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 24,
      "max": 72,
      "step": 2,
      "unit": "px",
      "label": "Heading size",
      "default": 40
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "min": 20,
      "max": 48,
      "step": 1,
      "unit": "px",
      "label": "Heading size (mobile)",
      "default": 28
    },
    {
      "type": "range",
      "id": "caption_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Caption size",
      "default": 14
    },
    {
      "type": "range",
      "id": "caption_size_mobile",
      "min": 11,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Caption size (mobile)",
      "default": 13
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Body text size",
      "default": 16
    },
    {
      "type": "range",
      "id": "text_size_mobile",
      "min": 13,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Body text size (mobile)",
      "default": 15
    },
    {
      "type": "range",
      "id": "button_size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Button text size",
      "default": 15
    },
    {
      "type": "range",
      "id": "button_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Button border radius",
      "default": 40
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#070D16"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "caption_color",
      "label": "Caption",
      "default": "#0DAAEF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Body text",
      "default": "#A8B0BD"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Text link",
      "default": "#0DAAEF"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Primary button text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "button_secondary_text_color",
      "label": "Secondary button text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "button_secondary_border_color",
      "label": "Secondary button border",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 52
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "t:sections.rich-text.blocks.heading.name",
      "limit": 3,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "t:sections.rich-text.blocks.heading.settings.heading.default",
          "label": "t:sections.rich-text.blocks.heading.settings.heading.label"
        }
      ]
    },
    {
      "type": "caption",
      "name": "t:sections.rich-text.blocks.caption.name",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "caption",
          "default": "t:sections.rich-text.blocks.caption.settings.text.default",
          "label": "t:sections.rich-text.blocks.caption.settings.text.label"
        },
        {
          "type": "select",
          "id": "text_style",
          "options": [
            {
              "value": "subtitle",
              "label": "t:sections.rich-text.blocks.caption.settings.text_style.options__1.label"
            },
            {
              "value": "caption-with-letter-spacing",
              "label": "t:sections.rich-text.blocks.caption.settings.text_style.options__2.label"
            }
          ],
          "default": "caption-with-letter-spacing",
          "label": "t:sections.rich-text.blocks.caption.settings.text_style.label"
        }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.rich-text.blocks.text.name",
      "limit": 3,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "default": "t:sections.rich-text.blocks.text.settings.text.default",
          "label": "t:sections.rich-text.blocks.text.settings.text.label"
        }
      ]
    },
    {
      "type": "button",
      "name": "t:sections.rich-text.blocks.buttons.name",
      "limit": 2,
      "settings": [
        {
          "type": "header",
          "content": "t:sections.rich-text.blocks.buttons.settings.header_button1.content"
        },
        {
          "type": "text",
          "id": "button_label",
          "default": "t:sections.rich-text.blocks.buttons.settings.button_label_1.default",
