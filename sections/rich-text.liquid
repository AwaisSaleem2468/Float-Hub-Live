        },
        {
          "type": "product",
          "id": "button_product_2",
          "label": "Product",
          "info": "Optional. Used when no custom link is set."
        },
        {
          "type": "checkbox",
          "id": "button_redirect_checkout_2",
          "label": "Redirect to checkout",
