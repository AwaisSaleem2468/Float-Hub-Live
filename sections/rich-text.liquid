          "info": "If a product is selected, skip the product page and go straight to checkout."
        },
        {
          "type": "url",
          "id": "button_link_2",
          "label": "t:sections.rich-text.blocks.buttons.settings.button_link_2.label",
          "info": "Optional override. Takes priority over product / checkout."
        },
        {
          "type": "checkbox",
          "id": "button_style_secondary_2",
          "default": false,
          "label": "t:sections.rich-text.blocks.buttons.settings.button_style_secondary_2.label"
        },
        {
          "type": "header",
          "content": "Button 3"
        },
        {
          "type": "text",
          "id": "button_label_3",
          "label": "Label",
          "info": "Leave blank to hide this button."
        },
        {
          "type": "product",
          "id": "button_product_3",
          "label": "Product",
          "info": "Optional. Used when no custom link is set."
        },
        {
          "type": "checkbox",
          "id": "button_redirect_checkout_3",
          "label": "Redirect to checkout",
          "default": false,
          "info": "If a product is selected, skip the product page and go straight to checkout."
        },
        {
          "type": "url",
          "id": "button_link_3",
          "label": "Link",
          "info": "Optional override. Takes priority over product / checkout."
        },
        {
          "type": "checkbox",
          "id": "button_style_secondary_3",
          "default": false,
          "label": "Outline style"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.rich-text.presets.name",
      "blocks": [
        {
          "type": "heading"
        },
        {
          "type": "text"
        },
        {
          "type": "button"
        }
      ]
    }
  ]
}
{% endschema %}
