{% style %}
  #TestimonialGrid-{{ section.id }} {
    --tg-bg: {{ section.settings.background_color }};
    --tg-card: {{ section.settings.card_background }};
    --tg-border: {{ section.settings.card_border }};
    --tg-title: {{ section.settings.title_color }};
    --tg-text: {{ section.settings.text_color }};
    --tg-name: {{ section.settings.name_color }};
    --tg-muted: {{ section.settings.muted_color }};
    --tg-accent: {{ section.settings.accent_color }};
    --tg-gap: {{ section.settings.card_gap }}px;
    --tg-radius: {{ section.settings.card_radius }}px;
    --tg-avatar: {{ section.settings.avatar_size }}px;
    background-color: var(--tg-bg);
    color: var(--tg-title);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #TestimonialGrid-{{ section.id }} .tg__inner {
    width: 100%;
    max-width: {{ section.settings.content_width }}px;
    margin: 0 auto;
    padding: 0 1.5rem;
    box-sizing: border-box;
  }

  #TestimonialGrid-{{ section.id }} .tg__header {
    margin: 0 0 {{ section.settings.header_gap }}px;
    max-width: {{ section.settings.heading_max_width }}px;
    text-align: {{ section.settings.heading_alignment }};
    {% if section.settings.heading_alignment == 'center' %}
      margin-left: auto;
      margin-right: auto;
    {% elsif section.settings.heading_alignment == 'right' %}
      margin-left: auto;
      margin-right: 0;
    {% endif %}
  }

  #TestimonialGrid-{{ section.id }} .tg__eyebrow {
    margin: 0 0 0.75rem;
    color: var(--tg-accent);
    font-family: var(--font-body-family);
    font-size: {{ section.settings.eyebrow_size }}px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  #TestimonialGrid-{{ section.id }} .tg__heading {
    margin: 0;
    color: var(--tg-title);
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    font-size: {{ section.settings.heading_size }}px;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  #TestimonialGrid-{{ section.id }} .tg__heading-accent {
    color: var(--tg-accent);
  }

  #TestimonialGrid-{{ section.id }} .tg__description {
    margin: 0.85rem 0 0;
    color: var(--tg-muted);
    font-family: var(--font-body-family);
    font-size: {{ section.settings.description_size }}px;
    line-height: 1.6;
  }

  #TestimonialGrid-{{ section.id }} .tg__description p {
    margin: 0;
  }

  #TestimonialGrid-{{ section.id }} .tg__masonry {
    column-count: {{ section.settings.columns_desktop }};
    column-gap: var(--tg-gap);
  }

  #TestimonialGrid-{{ section.id }} .tg__card {
    break-inside: avoid;
    -webkit-column-break-inside: avoid;
    page-break-inside: avoid;
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.card_content_gap }}px;
    margin: 0 0 var(--tg-gap);
    padding: {{ section.settings.card_padding }}px;
    border-radius: var(--tg-radius);
    background: var(--tg-card);
    border: 1px solid var(--tg-border);
    box-sizing: border-box;
  }

  #TestimonialGrid-{{ section.id }} .tg__card-title {
    margin: 0;
    color: var(--tg-title);
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-weight: 700;
    font-size: {{ section.settings.card_title_size }}px;
    line-height: 1.3;
  }

  #TestimonialGrid-{{ section.id }} .tg__card-text {
    margin: 0;
    color: var(--tg-text);
    font-family: var(--font-body-family);
    font-size: {{ section.settings.card_text_size }}px;
    line-height: 1.55;
    white-space: pre-line;
  }

  #TestimonialGrid-{{ section.id }} .tg__author {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-top: 0.25rem;
  }

  #TestimonialGrid-{{ section.id }} .tg__avatar,
  #TestimonialGrid-{{ section.id }} .tg__avatar-placeholder {
    flex: 0 0 auto;
    width: var(--tg-avatar);
    height: var(--tg-avatar);
    border-radius: 50%;
    object-fit: cover;
  }

  #TestimonialGrid-{{ section.id }} .tg__avatar-placeholder {
    background: linear-gradient(145deg, #243147, #121a27);
  }

  #TestimonialGrid-{{ section.id }} .tg__author-copy {
    min-width: 0;
  }

  #TestimonialGrid-{{ section.id }} .tg__name {
    margin: 0;
    color: var(--tg-name);
    font-family: var(--font-body-family);
    font-size: {{ section.settings.name_size }}px;
    font-weight: 700;
    line-height: 1.3;
  }

  #TestimonialGrid-{{ section.id }} .tg__designation {
    margin: 0.2rem 0 0;
    color: var(--tg-muted);
    font-family: var(--font-body-family);
    font-size: {{ section.settings.designation_size }}px;
    line-height: 1.35;
  }

  @media screen and (max-width: 989px) {
    #TestimonialGrid-{{ section.id }} .tg__masonry {
      column-count: {{ section.settings.columns_tablet }};
    }

    #TestimonialGrid-{{ section.id }} .tg__heading {
      font-size: {{ section.settings.heading_size_tablet }}px;
    }
  }

  @media screen and (max-width: 749px) {
    #TestimonialGrid-{{ section.id }} .tg__inner {
      padding: 0 1rem;
    }

    #TestimonialGrid-{{ section.id }} .tg__masonry {
      column-count: {{ section.settings.columns_mobile }};
    }

    #TestimonialGrid-{{ section.id }} .tg__heading {
      font-size: {{ section.settings.heading_size_mobile }}px;
    }

    #TestimonialGrid-{{ section.id }} .tg__card {
      padding: {{ section.settings.card_padding_mobile }}px;
    }

    #TestimonialGrid-{{ section.id }} .tg__card-title {
      font-size: {{ section.settings.card_title_size_mobile }}px;
    }

    #TestimonialGrid-{{ section.id }} .tg__card-text {
      font-size: {{ section.settings.card_text_size_mobile }}px;
    }
  }
{% endstyle %}

<section
  id="TestimonialGrid-{{ section.id }}"
  class="tg"
  aria-label="{{ section.settings.heading | default: 'Testimonials' | escape }}"
>
  <div class="tg__inner">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.heading_accent != blank or section.settings.description != blank -%}
      <div class="tg__header">
        {%- if section.settings.eyebrow != blank -%}
          <p class="tg__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank or section.settings.heading_accent != blank -%}
          <h2 class="tg__heading">
            {%- if section.settings.heading != blank -%}
              <span>{{ section.settings.heading | escape }}</span>
            {%- endif -%}
            {%- if section.settings.heading_accent != blank -%}
              {%- if section.settings.heading != blank %} {% endif -%}
              <span class="tg__heading-accent">{{ section.settings.heading_accent | escape }}</span>
            {%- endif -%}
          </h2>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <div class="tg__description rte">{{ section.settings.description }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="tg__masonry">
        {%- for block in section.blocks -%}
          <article class="tg__card" {{ block.shopify_attributes }}>
            {%- if block.settings.review_title != blank -%}
              <h3 class="tg__card-title">{{ block.settings.review_title | escape }}</h3>
            {%- endif -%}

            {%- if block.settings.review_text != blank -%}
              <p class="tg__card-text">{{ block.settings.review_text | escape }}</p>
            {%- endif -%}

            {%- if block.settings.image != blank or block.settings.name != blank or block.settings.designation != blank -%}
              <div class="tg__author">
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 160
                    | image_tag:
                      class: 'tg__avatar',
                      loading: 'lazy',
                      widths: '64, 96, 128, 160',
                      sizes: 'var(--tg-avatar)',
                      alt: block.settings.name | default: block.settings.review_title | escape
                  }}
                {%- elsif block.settings.name != blank -%}
                  <span class="tg__avatar-placeholder" aria-hidden="true"></span>
                {%- endif -%}

                {%- if block.settings.name != blank or block.settings.designation != blank -%}
                  <div class="tg__author-copy">
                    {%- if block.settings.name != blank -%}
                      <p class="tg__name">{{ block.settings.name | escape }}</p>
                    {%- endif -%}
                    {%- if block.settings.designation != blank -%}
                      <p class="tg__designation">{{ block.settings.designation | escape }}</p>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>
            {%- endif -%}
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

