{%- liquid
  assign columns_desktop = section.settings.columns_desktop | default: 2
  assign overlay_color = section.settings.overlay_color | default: '#061018'
  assign overlay_opacity = section.settings.overlay_opacity | default: 60
  assign overlay_alpha = overlay_opacity | times: 1.0 | divided_by: 100.0
  assign overlay_fill = overlay_color | color_modify: 'alpha', overlay_alpha
  assign overlay_edge = overlay_color | color_modify: 'alpha', 0.85
  assign overlay_mid = overlay_color | color_modify: 'alpha', 0.2
  assign overlay_top = overlay_color | color_modify: 'alpha', 0.55
-%}

{% style %}
  #StackedOverlay-{{ section.id }} {
    --so-text: {{ section.settings.text_color }};
    --so-eyebrow: {{ section.settings.eyebrow_color }};
    --so-desc: {{ section.settings.description_color }};
    --so-btn-text: {{ section.settings.button_text_color }};
    --so-btn-border: {{ section.settings.button_border_color }};
    --so-height: {{ section.settings.panel_height }}px;
    --so-height-mobile: {{ section.settings.panel_height_mobile }}px;
    width: 100%;
    background: {{ section.settings.fallback_background }};
  }

  #StackedOverlay-{{ section.id }} .stacked-overlay__grid {
    display: grid;
    grid-template-columns: repeat({{ columns_desktop }}, minmax(0, 1fr));
    width: 100%;
  }

  #StackedOverlay-{{ section.id }} .stacked-overlay__panel {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: var(--so-height);
    overflow: hidden;
    text-align: center;
    color: var(--so-text);
  }

  #StackedOverlay-{{ section.id }} .stacked-overlay__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  #StackedOverlay-{{ section.id }} .stacked-overlay__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  #StackedOverlay-{{ section.id }} .stacked-overlay__media-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #0b1a24 0%, #163447 100%);
  }

  #StackedOverlay-{{ section.id }} .stacked-overlay__shade {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    pointer-events: none;
    display: block;
    background-color: {{ overlay_fill }};
    background-image:
      radial-gradient(
        ellipse 70% 55% at 50% 42%,
        rgba(0, 0, 0, 0) 0%,
        {{ overlay_mid }} 50%,
        {{ overlay_edge }} 100%
      ),
      linear-gradient(
        180deg,
        {{ overlay_top }} 0%,
        rgba(0, 0, 0, 0.12) 42%,
        {{ overlay_edge }} 100%
      );
  }

  #StackedOverlay-{{ section.id }} .stacked-overlay__content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: {{ section.settings.content_max_width }}px;
    margin: 0 auto;
    padding: {{ section.settings.content_padding_y }}px {{ section.settings.content_padding_x }}px;
    box-sizing: border-box;
  }

  #StackedOverlay-{{ section.id }} .stacked-overlay__eyebrow {
    margin: 0 0 {{ section.settings.eyebrow_spacing }}px;
    color: var(--so-eyebrow);
    font-family: var(--font-body-family);
    font-size: {{ section.settings.eyebrow_size }}px;
    font-weight: 600;
    letter-spacing: 0.16em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  #StackedOverlay-{{ section.id }} .stacked-overlay__heading {
    margin: 0;
    color: var(--so-text);
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    font-size: {{ section.settings.heading_size }}px;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  #StackedOverlay-{{ section.id }} .stacked-overlay__heading + .stacked-overlay__descriptions,
  #StackedOverlay-{{ section.id }} .stacked-overlay__heading + .stacked-overlay__btn {
    margin-top: {{ section.settings.heading_spacing }}px;
  }

  #StackedOverlay-{{ section.id }} .stacked-overlay__descriptions {
    margin: 0;
    padding: 0;
    list-style: none;
    width: 100%;
    color: var(--so-desc);
    font-family: var(--font-body-family);
    font-size: {{ section.settings.description_size }}px;
    line-height: {{ section.settings.description_line_height | times: 0.1 }};
  }

  #StackedOverlay-{{ section.id }} .stacked-overlay__descriptions li {
    margin: 0;
  }

  #StackedOverlay-{{ section.id }} .stacked-overlay__descriptions li + li {
    margin-top: {{ section.settings.description_item_spacing }}px;
  }

  #StackedOverlay-{{ section.id }} .stacked-overlay__descriptions + .stacked-overlay__btn {
    margin-top: {{ section.settings.description_spacing }}px;
  }

  #StackedOverlay-{{ section.id }} .stacked-overlay__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: {{ section.settings.button_height }}px;
    padding: 0.75rem {{ section.settings.button_padding_x }}px;
    border-radius: {{ section.settings.button_radius }}px;
    font-family: var(--font-body-family);
    font-size: {{ section.settings.button_size }}px;
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
    transition: transform 0.2s ease, background-color 0.2s ease, border-color 0.2s ease, filter 0.2s ease;
  }

  #StackedOverlay-{{ section.id }} .stacked-overlay__btn:hover {
    transform: translateY(-1px);
  }

  #StackedOverlay-{{ section.id }} .stacked-overlay__btn--outline {
    background: transparent;
    color: var(--so-btn-text);
    border: 1px solid var(--so-btn-border);
  }

  #StackedOverlay-{{ section.id }} .stacked-overlay__btn--outline:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: #fff;
  }

  #StackedOverlay-{{ section.id }} .stacked-overlay__btn--gradient {
    background: linear-gradient(to right, #3b82f6, #22d3ee);
    color: #ffffff;
    border: 1px solid transparent;
  }

  #StackedOverlay-{{ section.id }} .stacked-overlay__btn--gradient:hover {
    filter: brightness(1.05);
  }

  #StackedOverlay-{{ section.id }} .stacked-overlay__btn[aria-disabled='true'] {
    opacity: 0.55;
    pointer-events: none;
  }

  @media screen and (max-width: 749px) {
    #StackedOverlay-{{ section.id }} .stacked-overlay__grid {
      grid-template-columns: 1fr;
    }

    #StackedOverlay-{{ section.id }} .stacked-overlay__panel {
      min-height: var(--so-height-mobile);
    }

    #StackedOverlay-{{ section.id }} .stacked-overlay__heading {
      font-size: {{ section.settings.heading_size_mobile }}px;
    }

    #StackedOverlay-{{ section.id }} .stacked-overlay__eyebrow {
      font-size: {{ section.settings.eyebrow_size_mobile }}px;
    }

    #StackedOverlay-{{ section.id }} .stacked-overlay__descriptions {
      font-size: {{ section.settings.description_size_mobile }}px;
    }

    #StackedOverlay-{{ section.id }} .stacked-overlay__content {
      padding: 2rem 1.25rem;
    }
  }
{% endstyle %}

<section
  id="StackedOverlay-{{ section.id }}"
  class="stacked-overlay"
  aria-label="{{ section.settings.accessibility_label | default: 'Featured promotions' | escape }}"
>
  {%- if section.blocks.size > 0 -%}
    <div class="stacked-overlay__grid">
      {%- for block in section.blocks -%}
        <article class="stacked-overlay__panel" {{ block.shopify_attributes }}>
          <div class="stacked-overlay__media" aria-hidden="true">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 2000
                | image_tag:
                  loading: 'lazy',
                  widths: '600, 900, 1200, 1600, 2000',
                  sizes: '(min-width: 750px) 33vw, 100vw',
                  alt: ''
              }}
            {%- else -%}
              <div class="stacked-overlay__media-placeholder"></div>
            {%- endif -%}
          </div>

          <div class="stacked-overlay__shade" aria-hidden="true"></div>

          <div class="stacked-overlay__content">
            {%- if block.settings.eyebrow != blank -%}
              <p class="stacked-overlay__eyebrow">{{ block.settings.eyebrow | escape }}</p>
            {%- endif -%}

            {%- if block.settings.heading != blank -%}
              <h2 class="stacked-overlay__heading">{{ block.settings.heading | escape }}</h2>
            {%- endif -%}

            {%- if block.settings.description != blank -%}
              {%- assign description_raw = block.settings.description | newline_to_br -%}
              {%- assign description_lines = description_raw | split: '<br />' -%}
              {%- if description_lines.size == 1 -%}
                {%- assign description_lines = description_raw | split: '<br/>' -%}
              {%- endif -%}
              <ul class="stacked-overlay__descriptions">
                {%- for line in description_lines -%}
                  {%- assign line_text = line | strip_html | strip -%}
                  {%- if line_text != blank -%}
                    <li>{{ line_text | escape }}</li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            {%- endif -%}

            {%- if block.settings.button_label != blank -%}
              <a
                class="stacked-overlay__btn stacked-overlay__btn--{{ block.settings.button_style | default: section.settings.button_style }}"
                {% if block.settings.button_link != blank %}
                  href="{{ block.settings.button_link }}"
                {% else %}
                  role="link"
                  aria-disabled="true"
                {% endif %}
              >
                {{ block.settings.button_label | escape }}
              </a>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

