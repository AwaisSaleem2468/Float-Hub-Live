{{ 'custom-gift-product.css' | asset_url | stylesheet_tag }}
<script src="{{ 'custom-gift-product.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign first_tab = false
  assign tab_count = 0

  for block in section.blocks
    if block.type == 'tab'
      assign tab_count = tab_count | plus: 1
      if first_tab == false
        assign first_tab = block
      endif
    endif
  endfor

  assign button_label = section.settings.button_label | default: 'Buy As Gift'
  assign layout = section.settings.layout | default: 'carousel'
  assign columns = section.settings.columns | default: 4
  assign active_tab_id = ''
  assign card_image_bg = section.settings.card_image_bg

  if first_tab
    assign active_tab_id = first_tab.id
    if first_tab.settings.columns != blank
      assign columns = first_tab.settings.columns
    endif
  endif
-%}

<section
  id="GiftProduct-{{ section.id }}"
  class="gift-product gift-product--{{ layout }}"
  data-gift-product
  data-section-id="{{ section.id }}"
  data-layout="{{ layout }}"
  style="
    --gp-featured-bg: {{ section.settings.fallback_bg }};
    --gp-eyebrow: {{ section.settings.eyebrow_color }};
    --gp-heading: {{ section.settings.heading_color }};
    --gp-text: {{ section.settings.text_color }};
    --gp-tab-size: {{ section.settings.tab_size_desktop }}px;
    --gp-tab-size-mobile: {{ section.settings.tab_size_mobile }}px;
    --gp-tab-color: {{ section.settings.tab_text_color }};
    --gp-tab-color-mobile: {{ section.settings.tab_text_color_mobile }};
    --gp-tab-bg: {{ section.settings.tab_bg }};
    --gp-tab-bg-mobile: {{ section.settings.tab_bg_mobile }};
    --gp-tab-active-color: {{ section.settings.tab_active_text_color }};
    --gp-tab-active-color-mobile: {{ section.settings.tab_active_text_color_mobile }};
    --gp-active-tab: {{ section.settings.active_tab_bg }};
    --gp-active-tab-mobile: {{ section.settings.active_tab_bg_mobile }};
    --gp-columns: {{ columns }};
    --gp-image-radius: {{ section.settings.image_radius | default: 0 }}px;
    --gp-pad-top: {{ section.settings.padding_top }}px;
    --gp-pad-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="gift-product__inner page-width">
    <div class="gift-product__header">
      <div class="gift-product__intro">
        {%- if section.settings.eyebrow != blank -%}
          <p class="gift-product__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="gift-product__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <div class="gift-product__desc rte">{{ section.settings.description }}</div>
        {%- endif -%}
      </div>
    </div>

    {%- if tab_count > 0 -%}
      <div class="gift-product__toolbar">
        <div class="gift-product__tabs" role="tablist" aria-label="{{ section.settings.heading | escape }}">
          {%- for block in section.blocks -%}
            {%- if block.type == 'tab' -%}
              {%- liquid
                assign this_tab_id = block.id
                assign tab_label = block.settings.label
                if tab_label == blank and block.settings.collection != blank
                  assign tab_label = block.settings.collection.title
                endif
                if tab_label == blank
                  assign tab_label = 'Select collection'
                endif
                assign is_active = false
                if this_tab_id == active_tab_id
                  assign is_active = true
                endif
                assign tab_columns = block.settings.columns | default: section.settings.columns | default: 4
              -%}
              <button
                type="button"
                class="gift-product__tab{% if is_active %} is-active{% endif %}"
                role="tab"
                id="Tab-{{ section.id }}-{{ block.id }}"
                aria-selected="{{ is_active }}"
                data-gp-tab
                data-tab-id="{{ this_tab_id }}"
                data-columns="{{ tab_columns }}"
                {{ block.shopify_attributes }}
              >
                <span class="gift-product__tab-label">{{ tab_label | escape }}</span>
              </button>
            {%- endif -%}
          {%- endfor -%}
        </div>

        <div class="gift-product__arrows">
          <button
            type="button"
            class="gift-product__arrow"
            data-gp-prev
            aria-label="Previous products"
          >
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true" focusable="false">
              <path d="M11.25 4.5L6.75 9l4.5 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <button
            type="button"
            class="gift-product__arrow"
            data-gp-next
            aria-label="Next products"
          >
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true" focusable="false">
              <path d="M6.75 4.5L11.25 9l-4.5 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>
      </div>
    {%- endif -%}

    <div class="gift-product__viewport" data-gp-viewport>
      <div class="gift-product__track" data-gp-track>
        {%- for block in section.blocks -%}
          {%- if block.type == 'tab' -%}
            {%- liquid
              assign this_tab_id = block.id
              assign tab_collection = block.settings.collection
              assign products_to_show = block.settings.products_to_show | default: section.settings.products_to_show
              assign is_visible = false
              if this_tab_id == active_tab_id
                assign is_visible = true
              endif
            -%}

            {%- if tab_collection != blank and tab_collection.products_count > 0 -%}
              {%- for product in tab_collection.products limit: products_to_show -%}
                <div
                  class="gift-product__slide{% unless is_visible %} hidden{% endunless %}"
                  data-gp-slide
                  data-tab="{{ this_tab_id }}"
                  role="tabpanel"
                  aria-labelledby="Tab-{{ section.id }}-{{ block.id }}"
                  {% unless is_visible %}hidden{% endunless %}
                >
                  {% render 'custom-gift-product-card',
                    product: product,
                    tab_id: this_tab_id,
                    button_label: button_label,
                    show_rating: section.settings.show_rating,
                    image_bg: card_image_bg
                  %}
                </div>
              {%- endfor -%}
            {%- else -%}
              {%- for i in (1..4) -%}
                <div
                  class="gift-product__slide{% unless is_visible %} hidden{% endunless %}"
                  data-gp-slide
                  data-tab="{{ this_tab_id }}"
                  {% unless is_visible %}hidden{% endunless %}
                >
                  <article class="gift-product__card gift-product__card--placeholder">
                    <div class="gift-product__card-media" style="--card-media-bg: {{ card_image_bg }};">
                      {{ 'product-1' | placeholder_svg_tag: 'gift-product__card-image placeholder-svg' }}
                    </div>
                    <div class="gift-product__card-body">
                      <h3 class="gift-product__card-title">
                        {%- if tab_collection == blank -%}
                          Select a collection
                        {%- else -%}
                          Add products to {{ tab_collection.title | escape }}
                        {%- endif -%}
                      </h3>
                      <div class="gift-product__price">
                        <span class="gift-product__price-current">$0.00</span>
                      </div>
                      <button type="button" class="gift-product__atc" disabled>{{ button_label | escape }}</button>
                    </div>
                  </article>
                </div>
              {%- endfor -%}
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Gift Products",
  "tag": "section",
  "class": "section-custom-gift-product",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "GIFT CARDS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Choose the perfect gift"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Each tab swaps the cards and changes this section's background. Use the arrows, or swipe on mobile.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Buy As Gift"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Default products per tab",
      "default": 8,
      "info": "Used when a tab does not set its own limit."
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show product rating",
      "default": true,
      "info": "Uses decimal metafield custom.product_rating and integer metafield custom.product_rating_stars."
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Product layout",
      "options": [
        { "value": "carousel", "label": "Carousel" },
        { "value": "grid", "label": "Grid" }
      ],
      "default": "carousel"
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Products per row",
      "default": 4,
      "info": "Default for tabs that do not set their own products per row. Desktop only."
    },
    {
      "type": "header",
      "content": "Tabs"
    },
    {
      "type": "range",
      "id": "tab_size_desktop",
      "min": 11,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Tab font size — desktop",
      "default": 14
    },
    {
      "type": "range",
      "id": "tab_size_mobile",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Tab font size — mobile",
      "default": 13
    },
    {
      "type": "color",
      "id": "tab_text_color",
      "label": "Tab text — desktop",
      "default": "#A8B0BD"
    },
    {
      "type": "color",
      "id": "tab_text_color_mobile",
      "label": "Tab text — mobile",
      "default": "#A8B0BD"
    },
    {
      "type": "color",
      "id": "tab_active_text_color",
      "label": "Active tab text — desktop",
      "default": "#061018"
    },
    {
      "type": "color",
      "id": "tab_active_text_color_mobile",
      "label": "Active tab text — mobile",
      "default": "#061018"
    },
    {
      "type": "color",
      "id": "tab_bg",
      "label": "Tab background — desktop",
      "default": "#1A2433"
    },
    {
      "type": "color",
      "id": "tab_bg_mobile",
      "label": "Tab background — mobile",
      "default": "#1A2433"
    },
    {
      "type": "color",
      "id": "active_tab_bg",
      "label": "Active tab background — desktop",
      "default": "#0DAAEF"
    },
    {
      "type": "color",
      "id": "active_tab_bg_mobile",
      "label": "Active tab background — mobile",
      "default": "#0DAAEF"
    },
    {
      "type": "color",
      "id": "card_image_bg",
      "label": "Card image background",
      "default": "#1A2433"
    },
    {
      "type": "range",
      "id": "image_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Product image radius",
      "default": 0
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "fallback_bg",
      "label": "Section background",
      "default": "#070D16"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow",
      "default": "#22D3EE"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Description",
      "default": "#A8B0BD"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Collection tab",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "Products from this collection appear automatically when the tab is active."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Tab label",
          "info": "Optional. Defaults to the collection title."
        },
        {
          "type": "range",
          "id": "products_to_show",
          "min": 2,
          "max": 12,
          "step": 1,
          "label": "Products to show",
          "default": 8
        },
        {
          "type": "range",
          "id": "columns",
          "min": 2,
          "max": 4,
          "step": 1,
          "label": "Products per row",
          "default": 4,
          "info": "Desktop grid and carousel. Mobile always shows a 1.3-card slider."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Gift Products",
      "category": "Custom Sections",
      "blocks": [
        {
          "type": "tab",
          "settings": {
            "label": "Gift cards",
            "products_to_show": 8,
            "columns": 4
          }
        },
        {
          "type": "tab",
          "settings": {
            "label": "Sessions",
            "products_to_show": 8,
            "columns": 4
          }
        },
        {
          "type": "tab",
          "settings": {
            "label": "Memberships",
            "products_to_show": 8,
            "columns": 4
          }
        },
        {
          "type": "tab",
          "settings": {
            "label": "Bundles",
            "products_to_show": 8,
            "columns": 4
          }
        }
      ]
    }
  ]
}
{% endschema %}
