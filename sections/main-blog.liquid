{{ 'component-article-card.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'section-main-blog.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign columns_desktop = section.settings.columns_desktop | default: 4
  assign posts_per_page = section.settings.posts_per_page | default: 12
  if posts_per_page < 1
    assign posts_per_page = 12
  endif
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  #MainBlog-{{ section.id }} {
    --mb-section-bg: {{ section.settings.section_background }};
    --mb-heading-color: {{ section.settings.heading_color }};
    --mb-card-bg: {{ section.settings.card_background }};
    --mb-title-color: {{ section.settings.title_color }};
    --mb-meta-color: {{ section.settings.meta_color }};
    --mb-excerpt-color: {{ section.settings.excerpt_color }};
    --mb-category-color: {{ section.settings.category_color }};
    --mb-heading-size: {{ section.settings.heading_font_size }}px;
    --mb-title-size: {{ section.settings.title_font_size }}px;
    --mb-meta-size: {{ section.settings.meta_font_size }}px;
    --mb-excerpt-size: {{ section.settings.excerpt_font_size }}px;
    --mb-category-size: {{ section.settings.category_font_size }}px;
    --mb-card-radius: {{ section.settings.card_radius }}px;
    --mb-image-radius: {{ section.settings.image_radius }}px;
    --mb-card-gap: {{ section.settings.card_gap }}px;
    --mb-content-padding: {{ section.settings.content_padding }}px;
    --mb-columns: {{ columns_desktop }};
    background-color: var(--mb-section-bg);
  }

  #MainBlog-{{ section.id }} .main-blog__inner {
    width: 100%;
    max-width: var(--page-width);
    margin: 0 auto;
    padding-left: var(--mb-content-padding);
    padding-right: var(--mb-content-padding);
    box-sizing: border-box;
  }

  #MainBlog-{{ section.id }} .main-blog__title {
    margin: 0 0 {{ section.settings.heading_bottom_gap }}px;
    color: var(--mb-heading-color);
    font-size: var(--mb-heading-size);
    line-height: 1.2;
  }

  #MainBlog-{{ section.id }} .blog-articles {
    display: grid;
    grid-template-columns: repeat(var(--mb-columns), minmax(0, 1fr));
    column-gap: var(--mb-card-gap);
    row-gap: var(--mb-card-gap);
  }

  #MainBlog-{{ section.id }} .blog-articles--collage {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  #MainBlog-{{ section.id }} .article-card,
  #MainBlog-{{ section.id }} .article-card .card__inner {
    background: var(--mb-card-bg) !important;
    border-radius: var(--mb-card-radius);
    overflow: hidden;
  }

  #MainBlog-{{ section.id }} .article-card .card__media,
  #MainBlog-{{ section.id }} .article-card__image-wrapper,
  #MainBlog-{{ section.id }} .article-card__image,
  #MainBlog-{{ section.id }} .article-card__image.media {
    border-radius: var(--mb-image-radius) !important;
    overflow: hidden;
  }

  #MainBlog-{{ section.id }} .article-card__image img,
  #MainBlog-{{ section.id }} .article-card .card__media img,
  #MainBlog-{{ section.id }} .article-card .media > img {
    border-radius: var(--mb-image-radius) !important;
  }

  #MainBlog-{{ section.id }} .article-card .card__inner .card__media,
  #MainBlog-{{ section.id }} .article-card .article-card__image-wrapper {
    margin: {{ section.settings.image_inset }}px;
    width: calc(100% - {{ section.settings.image_inset | times: 2 }}px);
    max-width: calc(100% - {{ section.settings.image_inset | times: 2 }}px);
  }

  #MainBlog-{{ section.id }} .article-card .card__content {
    background: transparent;
    padding: 0;
  }

  #MainBlog-{{ section.id }} .article-card .card__information,
  #MainBlog-{{ section.id }} .article-card .card-information {
    background: transparent;
    padding: {{ section.settings.card_info_padding_top | default: 16 }}px {{ section.settings.card_info_padding_x | default: 24 }}px {{ section.settings.card_info_padding_bottom | default: 24 }}px;
  }

  #MainBlog-{{ section.id }} .pagination-wrapper {
    margin-top: 4rem;
  }

  #MainBlog-{{ section.id }} .pagination__item {
    color: var(--mb-title-color);
  }

  #MainBlog-{{ section.id }} .pagination__item--current {
    color: var(--mb-category-color);
  }

  #MainBlog-{{ section.id }} .pagination__item-arrow .svg-wrapper,
  #MainBlog-{{ section.id }} .pagination__item-arrow svg {
    color: var(--mb-title-color);
  }

  #MainBlog-{{ section.id }} .article-card .card__heading,
  #MainBlog-{{ section.id }} .article-card .card__heading a {
    color: var(--mb-title-color) !important;
    font-size: var(--mb-title-size) !important;
    line-height: 1.3;
  }

  #MainBlog-{{ section.id }} .article-card__category {
    margin: 0 0 0.5rem;
    color: var(--mb-category-color);
    font-size: var(--mb-category-size);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1.3;
  }

  #MainBlog-{{ section.id }} .article-card__info,
  #MainBlog-{{ section.id }} .article-card__info a,
  #MainBlog-{{ section.id }} .article-card__info time,
  #MainBlog-{{ section.id }} .article-card__author {
    color: var(--mb-meta-color) !important;
    font-size: var(--mb-meta-size) !important;
  }

  #MainBlog-{{ section.id }} .article-card__excerpt,
  #MainBlog-{{ section.id }} .article-card__footer {
    color: var(--mb-excerpt-color) !important;
    font-size: var(--mb-excerpt-size) !important;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  @media screen and (max-width: 989px) {
    #MainBlog-{{ section.id }} .blog-articles:not(.blog-articles--collage) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    #MainBlog-{{ section.id }} {
      --mb-heading-size: {{ section.settings.heading_font_size_mobile }}px;
      --mb-title-size: {{ section.settings.title_font_size_mobile }}px;
      --mb-meta-size: {{ section.settings.meta_font_size_mobile }}px;
      --mb-excerpt-size: {{ section.settings.excerpt_font_size_mobile }}px;
      --mb-category-size: {{ section.settings.category_font_size_mobile }}px;
      --mb-content-padding: {{ section.settings.content_padding_mobile }}px;
    }

    #MainBlog-{{ section.id }} .blog-articles,
    #MainBlog-{{ section.id }} .blog-articles--collage {
      grid-template-columns: 1fr;
    }
  }
{%- endstyle -%}

{%- paginate blog.articles by posts_per_page -%}
  <div
    id="MainBlog-{{ section.id }}"
    class="main-blog section-{{ section.id }}-padding"
  >
    <div class="main-blog__inner">
      <h1 class="main-blog__title title--primary{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
        {{ blog.title | escape }}
      </h1>

      <div class="blog-articles{% if section.settings.layout == 'collage' %} blog-articles--collage{% endif %}">
        {%- for article in blog.articles -%}
          <div
            class="blog-articles__article article{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            {% if settings.animations_reveal_on_scroll %}
              data-cascade
              style="--animation-order: {{ forloop.index }};"
            {% endif %}
          >
            {%- render 'article-card',
              blog: blog,
              article: article,
              media_height: section.settings.image_height,
              media_aspect_ratio: article.image.aspect_ratio,
              show_image: section.settings.show_image,
              show_date: section.settings.show_date,
              show_author: section.settings.show_author,
              show_category: section.settings.show_category,
              show_excerpt: section.settings.show_excerpt
            -%}
          </div>
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        {%- render 'pagination', paginate: paginate -%}
      {%- endif -%}
    </div>
  </div>
{%- endpaginate -%}

{% schema %}
{
  "name": "t:sections.main-blog.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "options": [
        {
          "value": "grid",
          "label": "t:sections.main-blog.settings.layout.options__1.label"
        },
        {
          "value": "collage",
          "label": "t:sections.main-blog.settings.layout.options__2.label"
        }
      ],
      "default": "grid",
      "label": "t:sections.main-blog.settings.layout.label"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4,
      "label": "Cards per row (desktop)",
      "info": "Used when layout is set to Grid."
    },
    {
      "type": "range",
      "id": "posts_per_page",
      "min": 4,
      "max": 24,
      "step": 2,
      "default": 12,
      "label": "Posts per page",
      "info": "Shows this many posts, then pagination for the rest."
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "default": true,
      "label": "t:sections.main-blog.settings.show_image.label"
    },
    {
      "type": "select",
      "id": "image_height",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.main-blog.settings.image_height.options__1.label"
        },
        {
          "value": "small",
          "label": "t:sections.main-blog.settings.image_height.options__2.label"
        },
        {
          "value": "medium",
          "label": "t:sections.main-blog.settings.image_height.options__3.label"
        },
        {
          "value": "large",
          "label": "t:sections.main-blog.settings.image_height.options__4.label"
        }
      ],
      "default": "medium",
      "label": "t:sections.main-blog.settings.image_height.label"
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "default": true,
      "label": "t:sections.main-blog.settings.show_date.label"
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "default": false,
      "label": "t:sections.main-blog.settings.show_author.label"
    },
    {
      "type": "checkbox",
      "id": "show_category",
      "default": false,
      "label": "Show blog category",
      "info": "Uses the first article tag, or the blog title if no tags exist."
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "default": true,
      "label": "Show excerpt"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Section background",
      "default": "#070D16"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Page heading",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#121A27"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Post title",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "meta_color",
      "label": "Date / author",
      "default": "#A8B0BD"
    },
    {
      "type": "color",
      "id": "category_color",
      "label": "Category",
      "default": "#0DAAEF"
    },
    {
      "type": "color",
      "id": "excerpt_color",
      "label": "Excerpt",
      "default": "#C8CED8"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "min": 24,
      "max": 64,
      "step": 1,
      "unit": "px",
      "label": "Page heading size",
      "default": 42
    },
    {
      "type": "range",
      "id": "heading_font_size_mobile",
      "min": 22,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Page heading size (mobile)",
      "default": 30
    },
    {
      "type": "range",
      "id": "title_font_size",
      "min": 14,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Post title size",
      "default": 20
    },
    {
      "type": "range",
      "id": "title_font_size_mobile",
      "min": 14,
      "max": 28,
      "step": 1,
      "unit": "px",
      "label": "Post title size (mobile)",
      "default": 18
    },
    {
      "type": "range",
      "id": "meta_font_size",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Date / author size",
      "default": 12
    },
    {
      "type": "range",
      "id": "meta_font_size_mobile",
      "min": 10,
      "max": 16,
      "step": 1,
      "unit": "px",
      "label": "Date / author size (mobile)",
      "default": 11
    },
    {
      "type": "range",
      "id": "category_font_size",
      "min": 10,
      "max": 16,
      "step": 1,
      "unit": "px",
      "label": "Category size",
      "default": 11
    },
    {
      "type": "range",
      "id": "category_font_size_mobile",
      "min": 10,
      "max": 14,
      "step": 1,
      "unit": "px",
      "label": "Category size (mobile)",
      "default": 10
    },
    {
      "type": "range",
      "id": "excerpt_font_size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Excerpt size",
      "default": 15
    },
    {
      "type": "range",
      "id": "excerpt_font_size_mobile",
      "min": 12,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Excerpt size (mobile)",
      "default": 14
    },
    {
      "type": "header",
      "content": "Card style"
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Card corner radius",
      "default": 24
    },
    {
      "type": "range",
      "id": "image_radius",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Image corner radius",
      "default": 16
    },
    {
      "type": "range",
      "id": "image_inset",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Image inset padding",
      "info": "Adds space around the image so rounded corners are visible on all sides.",
      "default": 12
    },
    {
      "type": "range",
      "id": "card_info_padding_x",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Card text padding (left/right)",
      "default": 24
    },
    {
      "type": "range",
      "id": "card_info_padding_top",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Card text padding (top)",
      "default": 16
    },
    {
      "type": "range",
      "id": "card_info_padding_bottom",
      "min": 8,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Card text padding (bottom)",
      "default": 24
    },
    {
      "type": "range",
      "id": "card_gap",
      "min": 8,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Gap between cards",
      "default": 28
    },
    {
      "type": "range",
      "id": "heading_bottom_gap",
      "min": 12,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Space below page heading",
      "default": 32
    },
    {
      "type": "header",
      "content": "Content padding"
    },
    {
      "type": "range",
      "id": "content_padding",
      "min": 12,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Content padding (desktop)",
      "info": "Horizontal padding around the blog content.",
      "default": 40
    },
    {
      "type": "range",
      "id": "content_padding_mobile",
      "min": 12,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Content padding (mobile)",
      "default": 20
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
