      "label": "Icon size",
      "default": 64
    },
    {
      "type": "range",
      "id": "icon_size_mobile",
      "min": 28,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "Icon size (mobile)",
      "default": 48
