{%- liquid
  assign use_custom_icon = false
  if section.settings.custom_icon != blank
    assign use_custom_icon = true
  endif
-%}

{% style %}
  #IconTextH-{{ section.id }} {
    --ith-bg: {{ section.settings.background_color }};
    --ith-text: {{ section.settings.text_color }};
    --ith-link: {{ section.settings.link_color }};
    --ith-link-hover: {{ section.settings.link_hover_color }};
    --ith-icon: {{ section.settings.icon_color }};
    --ith-icon-from: {{ section.settings.icon_gradient_from }};
    --ith-icon-to: {{ section.settings.icon_gradient_to }};
    --ith-gap: {{ section.settings.content_gap }}px;
    --ith-icon-size: {{ section.settings.icon_size }}px;
    background-color: var(--ith-bg);
    color: var(--ith-text);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #IconTextH-{{ section.id }} .icon-text-h__inner {
    display: flex;
    align-items: {{ section.settings.vertical_alignment }};
    justify-content: {{ section.settings.horizontal_alignment }};
    gap: var(--ith-gap);
    width: 100%;
    max-width: {{ section.settings.content_width }}px;
    margin: 0 auto;
    padding: 0 1.5rem;
    box-sizing: border-box;
    text-align: left;
  }

  #IconTextH-{{ section.id }} .icon-text-h__icon {
    flex: 0 0 auto;
    width: var(--ith-icon-size);
    height: var(--ith-icon-size);
    line-height: 0;
  }

  #IconTextH-{{ section.id }} .icon-text-h__icon img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  #IconTextH-{{ section.id }} .icon-text-h__icon .svg-wrapper,
  #IconTextH-{{ section.id }} .icon-text-h__icon svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  {%- if section.settings.icon_style == 'gradient' and use_custom_icon == false -%}
    #IconTextH-{{ section.id }} .icon-text-h__icon .svg-wrapper {
      background-image: linear-gradient(180deg, var(--ith-icon-from) 0%, var(--ith-icon-to) 100%);
      -webkit-mask-image: url("{{ section.settings.icon | replace: '_', '-' | prepend: 'icon-' | append: '.svg' | asset_url }}");
      mask-image: url("{{ section.settings.icon | replace: '_', '-' | prepend: 'icon-' | append: '.svg' | asset_url }}");
      -webkit-mask-size: contain;
      mask-size: contain;
      -webkit-mask-repeat: no-repeat;
      mask-repeat: no-repeat;
      -webkit-mask-position: center;
      mask-position: center;
    }

    #IconTextH-{{ section.id }} .icon-text-h__icon .svg-wrapper svg {
      opacity: 0;
    }
  {%- else -%}
    #IconTextH-{{ section.id }} .icon-text-h__icon .svg-wrapper,
    #IconTextH-{{ section.id }} .icon-text-h__icon svg {
      color: var(--ith-icon);
      fill: currentColor;
    }
  {%- endif -%}

  #IconTextH-{{ section.id }} .icon-text-h__content {
    flex: 1 1 auto;
    min-width: 0;
    max-width: {{ section.settings.text_max_width }}px;
    font-family: var(--font-body-family);
    font-size: {{ section.settings.text_size }}px;
    line-height: 1.55;
    color: var(--ith-text);
  }

  #IconTextH-{{ section.id }} .icon-text-h__content p {
    margin: 0;
  }

  #IconTextH-{{ section.id }} .icon-text-h__content p + p {
    margin-top: 0.15em;
  }

  #IconTextH-{{ section.id }} .icon-text-h__content strong,
  #IconTextH-{{ section.id }} .icon-text-h__content b {
    font-weight: 700;
    color: {{ section.settings.strong_color }};
  }

  #IconTextH-{{ section.id }} .icon-text-h__content a {
    color: var(--ith-link);
    text-decoration: underline;
    text-underline-offset: 0.15em;
    text-decoration-thickness: 1px;
    transition: color 0.2s ease;
  }

  #IconTextH-{{ section.id }} .icon-text-h__content a:hover {
    color: var(--ith-link-hover);
  }

  @media screen and (max-width: 749px) {
    #IconTextH-{{ section.id }} .icon-text-h__inner {
      {%- if section.settings.stack_on_mobile -%}
        flex-direction: column;
        align-items: {% if section.settings.horizontal_alignment == 'center' %}center{% elsif section.settings.horizontal_alignment == 'flex-end' %}flex-end{% else %}flex-start{% endif %};
        text-align: {% if section.settings.horizontal_alignment == 'center' %}center{% elsif section.settings.horizontal_alignment == 'flex-end' %}right{% else %}left{% endif %};
      {%- endif -%}
      padding: 0 1rem;
      gap: {{ section.settings.content_gap_mobile }}px;
    }

    #IconTextH-{{ section.id }} {
      --ith-icon-size: {{ section.settings.icon_size_mobile }}px;
    }

    #IconTextH-{{ section.id }} .icon-text-h__content {
      font-size: {{ section.settings.text_size_mobile }}px;
    }
  }
{% endstyle %}

<section
  id="IconTextH-{{ section.id }}"
  class="icon-text-h"
  aria-label="{{ section.settings.accessibility_label | default: 'Gift cards' | escape }}"
>
  <div class="icon-text-h__inner">
    {%- if use_custom_icon or section.settings.icon != 'none' -%}
      <div class="icon-text-h__icon" aria-hidden="true">
        {%- if use_custom_icon -%}
          {{
            section.settings.custom_icon
            | image_url: width: 240
            | image_tag:
              loading: 'lazy',
              widths: '80, 120, 160, 240',
              sizes: 'var(--ith-icon-size)',
              alt: ''
          }}
        {%- else -%}
          {% render 'icon-accordion', icon: section.settings.icon %}
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div class="icon-text-h__content rte">
        {{ section.settings.text }}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Icon Text Horizontal",
  "tag": "section",
  "class": "section-icon-text-horizontal",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "richtext",
      "id": "text",
