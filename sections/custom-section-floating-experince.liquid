    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number",
          "info": "Leave blank to use automatic numbering."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Step title"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Describe this step of the floating experience.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Floating Experience",
      "category": "Custom Sections",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "number": "1",
            "title": "Pre-Float",
            "text": "<p>Our staff will give you a full walkthrough of the process to ensure that you're informed and feel at home in our center.</p>"
          }
        },
        {
          "type": "step",
          "settings": {
            "number": "2",
            "title": "Preparing",
            "text": "<p>You will enter your private float room and take a shower before starting your session to ensure any oils, dirt, and perfumes are removed.</p>"
          }
        },
        {
          "type": "step",
          "settings": {
            "number": "3",
            "title": "Letting Go",
            "text": "<p>It will take some time to get used to the unique environment of the float tank so we encourage you to focus on your breath and try to let go.</p>"
          }
        },
        {
          "type": "step",
          "settings": {
            "number": "4",
            "title": "Post-Float Glow",
            "text": "<p>You will be notified your session is over by music in the pod. After your session you will shower again to remove any salt and are welcome to enjoy your new state in our relaxation suite.</p>"
