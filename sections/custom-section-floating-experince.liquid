    },
    {
      "type": "range",
      "id": "row_gap",
      "min": 12,
      "max": 48,
      "step": 4,
      "unit": "px",
      "label": "Inner row gap",
      "default": 24
    },
    {
      "type": "header",
      "content": "Timeline"
    },
    {
      "type": "color",
