      "default": "#3A4556"
    },
    {
      "type": "color",
      "id": "timeline_circle_bg",
      "label": "Circle background",
      "default": "#070D16"
    },
    {
      "type": "range",
      "id": "line_thickness",
      "min": 1,
      "max": 4,
      "step": 1,
      "unit": "px",
      "label": "Connecting line thickness",
      "default": 1
    },
    {
      "type": "range",
      "id": "circle_border_width",
      "min": 1,
      "max": 3,
      "step": 1,
      "unit": "px",
      "label": "Circle border width",
      "default": 1
    },
    {
      "type": "range",
      "id": "number_size",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "Number size",
      "default": 15
    },
    {
      "type": "header",
      "content": "Cards"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background",
      "default": "#121A27"
    },
    {
      "type": "color",
      "id": "card_border",
      "label": "Card border",
      "default": "#243041"
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Card border radius",
      "default": 12
    },
    {
      "type": "range",
      "id": "card_padding",
      "min": 12,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Card padding",
      "default": 24
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "step_title_size",
      "min": 16,
      "max": 36,
      "step": 1,
      "unit": "px",
      "label": "Step title size",
      "default": 22
    },
    {
      "type": "range",
      "id": "step_title_size_mobile",
      "min": 14,
