{% style %}
  #CustomRating-{{ section.id }} {
    --cr-bg: {{ section.settings.background_color }};
    --cr-card: {{ section.settings.card_background }};
    --cr-border: {{ section.settings.card_border }};
    --cr-star: {{ section.settings.star_color }};
    --cr-star-empty: {{ section.settings.star_empty_color }};
    --cr-score: {{ section.settings.score_color }};
    --cr-heading: {{ section.settings.heading_color }};
    --cr-text: {{ section.settings.text_color }};
    --cr-muted: {{ section.settings.muted_color }};
    --cr-star-size: {{ section.settings.star_size_desktop }}px;
    --cr-star-size-mobile: {{ section.settings.star_size_mobile }}px;
    --cr-score-size: {{ section.settings.score_size_desktop }}px;
    --cr-score-size-mobile: {{ section.settings.score_size_mobile }}px;
    --cr-label-size: {{ section.settings.label_size_desktop }}px;
    --cr-label-size-mobile: {{ section.settings.label_size_mobile }}px;
    --cr-caption-size: {{ section.settings.caption_size_desktop }}px;
    --cr-caption-size-mobile: {{ section.settings.caption_size_mobile }}px;
    --cr-heading-size: {{ section.settings.heading_size_desktop }}px;
    --cr-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --cr-align: {{ section.settings.content_alignment }};
    background-color: var(--cr-bg);
    color: var(--cr-text);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #CustomRating-{{ section.id }} .custom-rating__inner {
    width: 100%;
    max-width: {{ section.settings.content_width }}px;
    margin: 0 auto;
    padding: 0 1.5rem;
    text-align: var(--cr-align);
  }

  #CustomRating-{{ section.id }} .custom-rating__header {
    margin: 0 auto {{ section.settings.header_spacing }}px;
    max-width: 64rem;
  }

  #CustomRating-{{ section.id }} .custom-rating__eyebrow {
    margin: 0 0 0.8rem;
    color: {{ section.settings.eyebrow_color }};
    font-size: {{ section.settings.eyebrow_size }}px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  #CustomRating-{{ section.id }} .custom-rating__heading {
    margin: 0 0 0.8rem;
    color: var(--cr-heading);
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    font-size: var(--cr-heading-size);
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  #CustomRating-{{ section.id }} .custom-rating__description {
    margin: 0;
    color: var(--cr-muted);
    font-size: {{ section.settings.description_size }}px;
    line-height: 1.55;
  }

  #CustomRating-{{ section.id }} .custom-rating__description p {
    margin: 0;
  }

  #CustomRating-{{ section.id }} .custom-rating__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, minmax(0, 1fr));
    gap: {{ section.settings.card_gap }}px;
  }

  #CustomRating-{{ section.id }} .custom-rating__card {
    display: flex;
    flex-direction: column;
    align-items: {% if section.settings.content_alignment == 'center' %}center{% else %}flex-start{% endif %};
    gap: 0.6rem;
    height: 100%;
    padding: {{ section.settings.card_padding }}px;
    background: var(--cr-card);
    border: 1px solid var(--cr-border);
    border-radius: {{ section.settings.card_radius }}px;
    text-decoration: none;
    color: inherit;
  }

  #CustomRating-{{ section.id }} a.custom-rating__card:hover {
    border-color: color-mix(in srgb, var(--cr-star) 45%, var(--cr-border));
  }

  #CustomRating-{{ section.id }} .custom-rating__stars {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    color: var(--cr-star);
    line-height: 1;
  }

  #CustomRating-{{ section.id }} .custom-rating__star {
    width: var(--cr-star-size);
    height: var(--cr-star-size);
    flex-shrink: 0;
  }

  #CustomRating-{{ section.id }} .custom-rating__star--empty {
    color: var(--cr-star-empty);
  }

  #CustomRating-{{ section.id }} .custom-rating__score {
    margin: 0;
    color: var(--cr-score);
    font-family: var(--font-heading-family);
    font-size: var(--cr-score-size);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  #CustomRating-{{ section.id }} .custom-rating__label {
    margin: 0;
    color: var(--cr-heading);
    font-size: var(--cr-label-size);
    font-weight: 700;
    line-height: 1.3;
  }

  #CustomRating-{{ section.id }} .custom-rating__caption {
    margin: 0;
    color: var(--cr-muted);
    font-size: var(--cr-caption-size);
    line-height: 1.4;
  }

  @media screen and (max-width: 989px) {
    #CustomRating-{{ section.id }} .custom-rating__grid {
      grid-template-columns: repeat({{ section.settings.columns_tablet }}, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    #CustomRating-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.7 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.7 | round }}px;
    }

    #CustomRating-{{ section.id }} .custom-rating__inner {
      padding: 0 1.25rem;
    }

    #CustomRating-{{ section.id }} .custom-rating__heading {
      font-size: var(--cr-heading-size-mobile);
    }

    #CustomRating-{{ section.id }} .custom-rating__grid {
      grid-template-columns: repeat({{ section.settings.columns_mobile }}, minmax(0, 1fr));
    }

    #CustomRating-{{ section.id }} .custom-rating__star {
      width: var(--cr-star-size-mobile);
      height: var(--cr-star-size-mobile);
    }

    #CustomRating-{{ section.id }} .custom-rating__score {
      font-size: var(--cr-score-size-mobile);
    }

    #CustomRating-{{ section.id }} .custom-rating__label {
      font-size: var(--cr-label-size-mobile);
    }

    #CustomRating-{{ section.id }} .custom-rating__caption {
      font-size: var(--cr-caption-size-mobile);
    }
  }
{% endstyle %}

<section id="CustomRating-{{ section.id }}" class="custom-rating">
  <div class="custom-rating__inner">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.description != blank -%}
      <div class="custom-rating__header">
        {%- if section.settings.eyebrow != blank -%}
          <p class="custom-rating__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="custom-rating__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <div class="custom-rating__description rte">{{ section.settings.description }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="custom-rating__grid">
        {%- for block in section.blocks -%}
          {%- liquid
            assign star_count = block.settings.star_count | default: 5
            if star_count < 0
              assign star_count = 0
            endif
            if star_count > 5
              assign star_count = 5
            endif
            assign card_tag = 'div'
            if block.settings.link != blank
              assign card_tag = 'a'
            endif
          -%}
          <{{ card_tag }}
            class="custom-rating__card"
            {% if card_tag == 'a' %}href="{{ block.settings.link }}"{% endif %}
            {{ block.shopify_attributes }}
          >
            {%- if section.settings.show_stars -%}
              <span
                class="custom-rating__stars"
                aria-label="Rated {{ block.settings.rating_value | escape }} out of 5"
              >
                {%- for i in (1..5) -%}
                  <svg
                    class="custom-rating__star{% if i > star_count %} custom-rating__star--empty{% endif %}"
                    viewBox="0 0 14 14"
                    fill="currentColor"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <path d="M7 0.5l1.76 3.57 3.94.57-2.85 2.78.67 3.92L7 9.5l-3.52 1.84.67-3.92L1.3 4.64l3.94-.57L7 .5z"/>
                  </svg>
                {%- endfor -%}
              </span>
            {%- endif -%}

            {%- if block.settings.rating_value != blank -%}
              <p class="custom-rating__score">{{ block.settings.rating_value | escape }}</p>
            {%- endif -%}

            {%- if block.settings.label != blank -%}
              <p class="custom-rating__label">{{ block.settings.label | escape }}</p>
            {%- endif -%}

            {%- if block.settings.caption != blank -%}
              <p class="custom-rating__caption">{{ block.settings.caption | escape }}</p>
            {%- endif -%}
          </{{ card_tag }}>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Custom Rating",
  "tag": "section",
  "class": "section-custom-rating",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "REVIEWS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by floaters across London"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Join hundreds of five-star reviews from people who gifted calm, recovery, and a reset.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_stars",
      "label": "Show stars",
      "default": true
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
