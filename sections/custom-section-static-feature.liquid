{%- liquid
  assign text_size_desktop = section.settings.text_size_desktop | default: 13
  assign text_size_mobile = section.settings.text_size_mobile | default: 12
  assign enable_marquee = section.settings.enable_marquee
  assign marquee_speed = section.settings.marquee_speed | default: 40
  assign pause_on_hover = section.settings.pause_on_hover
-%}

{% style %}
  #StaticFeature-{{ section.id }} {
    --sf-bg: {{ section.settings.background_color }};
    --sf-text: {{ section.settings.text_color }};
    --sf-icon: {{ section.settings.icon_color }};
    --sf-border: {{ section.settings.border_color }};
    --sf-border-width: {{ section.settings.border_width }}px;
    --sf-size: {{ text_size_desktop }}px;
    --sf-size-mobile: {{ text_size_mobile }}px;
    --sf-gap: {{ section.settings.item_gap }}px;
    --sf-marquee-duration: {{ marquee_speed }}s;
    background-color: var(--sf-bg);
    color: var(--sf-text);
    border-top: var(--sf-border-width) solid var(--sf-border);
    border-bottom: var(--sf-border-width) solid var(--sf-border);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    overflow: hidden;
  }

  #StaticFeature-{{ section.id }} .static-feature__viewport {
    width: 100%;
    overflow: hidden;
  }

  #StaticFeature-{{ section.id }} .static-feature__track {
    display: flex;
    align-items: center;
    width: max-content;
    gap: 0;
  }

  #StaticFeature-{{ section.id }} .static-feature__group {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: var(--sf-gap);
    padding-right: var(--sf-gap);
    flex-shrink: 0;
  }

  #StaticFeature-{{ section.id }} .static-feature__item {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0;
    font-family: var(--font-body-family);
    font-size: var(--sf-size);
    font-weight: 400;
    line-height: 1.5;
    color: var(--sf-text);
    white-space: nowrap;
  }

  #StaticFeature-{{ section.id }} .static-feature__item a {
    color: inherit;
    text-decoration: none;
  }

  #StaticFeature-{{ section.id }} .static-feature__item a:hover {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  #StaticFeature-{{ section.id }} .static-feature__icon {
    display: inline-flex;
    flex-shrink: 0;
    width: 1em;
    height: 1em;
    color: var(--sf-icon);
  }

  #StaticFeature-{{ section.id }} .static-feature__icon svg {
    display: block;
    width: 100%;
    height: 100%;
    fill: currentColor;
  }

  {%- if enable_marquee -%}
    #StaticFeature-{{ section.id }} .static-feature__track {
      animation: static-feature-marquee-{{ section.id }} var(--sf-marquee-duration) linear infinite;
    }

    {%- if pause_on_hover -%}
      #StaticFeature-{{ section.id }} .static-feature__viewport:hover .static-feature__track,
      #StaticFeature-{{ section.id }} .static-feature__viewport:focus-within .static-feature__track {
        animation-play-state: paused;
      }
    {%- endif -%}

    @keyframes static-feature-marquee-{{ section.id }} {
      from {
        transform: translate3d(0, 0, 0);
      }
      to {
        transform: translate3d(-50%, 0, 0);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      #StaticFeature-{{ section.id }} .static-feature__track {
        animation: none;
        justify-content: center;
        width: 100%;
        flex-wrap: wrap;
      }

      #StaticFeature-{{ section.id }} .static-feature__group--clone {
        display: none;
      }

      #StaticFeature-{{ section.id }} .static-feature__group {
        flex-wrap: wrap;
        justify-content: center;
        padding-right: 0;
        width: 100%;
        gap: 0.65rem var(--sf-gap);
        padding-left: 1.25rem;
        padding-right: 1.25rem;
      }
    }
  {%- else -%}
    #StaticFeature-{{ section.id }} .static-feature__track {
      width: 100%;
      justify-content: center;
    }

    #StaticFeature-{{ section.id }} .static-feature__group {
      flex-wrap: wrap;
      justify-content: center;
      padding-right: 0;
      gap: 0.65rem var(--sf-gap);
      padding-left: 1.5rem;
      padding-right: 1.5rem;
    }

    #StaticFeature-{{ section.id }} .static-feature__group--clone {
      display: none;
    }
  {%- endif -%}

  @media screen and (max-width: 749px) {
    #StaticFeature-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.85 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.85 | round: 0 }}px;
    }

    #StaticFeature-{{ section.id }} .static-feature__item {
      font-size: var(--sf-size-mobile);
    }
  }
{% endstyle %}

<section
  id="StaticFeature-{{ section.id }}"
  class="static-feature{% if enable_marquee %} static-feature--marquee{% endif %}"
  aria-label="{{ section.settings.accessibility_label | escape }}"
>
  {%- if section.blocks.size > 0 -%}
    <div class="static-feature__viewport">
      <div class="static-feature__track"{% if enable_marquee %} aria-hidden="false"{% endif %}>
        <div class="static-feature__group">
          {%- for block in section.blocks -%}
            {%- if block.settings.text != blank -%}
              <p class="static-feature__item" {{ block.shopify_attributes }}>
                {%- if block.settings.show_icon -%}
                  <span class="static-feature__icon" aria-hidden="true">
                    <svg viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg" focusable="false">
                      <path d="M8 1.2l1.85 3.75 4.15.6-3 2.93.7 4.12L8 10.7l-3.7 1.9.7-4.12-3-2.93 4.15-.6L8 1.2z"/>
                    </svg>
                  </span>
                {%- endif -%}
                {%- if block.settings.link != blank -%}
                  <a href="{{ block.settings.link }}">{{ block.settings.text | escape }}</a>
                {%- else -%}
                  <span>{{ block.settings.text | escape }}</span>
                {%- endif -%}
              </p>
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- if enable_marquee -%}
          <div class="static-feature__group static-feature__group--clone" aria-hidden="true">
            {%- for block in section.blocks -%}
              {%- if block.settings.text != blank -%}
                <p class="static-feature__item">
                  {%- if block.settings.show_icon -%}
                    <span class="static-feature__icon">
                      <svg viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg" focusable="false">
                        <path d="M8 1.2l1.85 3.75 4.15.6-3 2.93.7 4.12L8 10.7l-3.7 1.9.7-4.12-3-2.93 4.15-.6L8 1.2z"/>
                      </svg>
                    </span>
                  {%- endif -%}
                  <span>{{ block.settings.text | escape }}</span>
                </p>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Static Feature Bar",
  "tag": "section",
  "class": "section-static-feature",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Accessibility label",
      "default": "Store highlights"
    },
    {
      "type": "header",
      "content": "Marquee"
    },
    {
      "type": "checkbox",
      "id": "enable_marquee",
      "label": "Enable auto-scroll (marquee)",
      "default": true
    },
    {
      "type": "range",
      "id": "marquee_speed",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "s",
      "label": "Scroll duration",
      "default": 40,
      "info": "Higher value = slower scroll."
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on hover",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#0B1220"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#C8CED8"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Star icon",
      "default": "#D4AF37"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Top & bottom border",
      "default": "#243044"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "label": "Border thickness",
      "default": 1
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "text_size_desktop",
      "min": 11,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Text size (desktop)",
      "default": 13
    },
    {
      "type": "range",
      "id": "text_size_mobile",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Text size (mobile)",
      "default": 12
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "item_gap",
      "min": 16,
      "max": 72,
      "step": 4,
      "unit": "px",
      "label": "Space between items",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Padding top",
      "default": 14
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom",
      "default": 14
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Feature highlight"
        },
        {
          "type": "checkbox",
          "id": "show_icon",
          "label": "Show star icon",
          "default": false
        },
        {
          "type": "url",
          "id": "link",
          "label": "Optional link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Static Feature Bar",
      "category": "Custom Sections",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "text": "London's Highest Rated Float Centre",
            "show_icon": true
          }
        },
        {
          "type": "feature",
          "settings": {
            "text": "300+ Five-Star Reviews Online",
            "show_icon": false
          }
        },
        {
          "type": "feature",
          "settings": {
            "text": "6 Tanks - Largest in London",
            "show_icon": false
          }
        },
        {
          "type": "feature",
          "settings": {
            "text": "Old Street, Shoreditch · EC1V 9NQ",
            "show_icon": false
          }
        },
        {
          "type": "feature",
          "settings": {
            "text": "Open 7 Days - Book Online Instantly",
            "show_icon": false
          }
        }
      ]
    }
  ]
}
{% endschema %}
