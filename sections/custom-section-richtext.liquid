{% style %}
  #CustomRichtext-{{ section.id }} {
    --crt-bg: {{ section.settings.background_color }};
    --crt-text: {{ section.settings.text_color }};
    --crt-strong: {{ section.settings.strong_color }};
    --crt-badge-bg: {{ section.settings.badge_background }};
    --crt-badge-text: {{ section.settings.badge_text_color }};
    --crt-star: {{ section.settings.star_color }};
    --crt-text-size: {{ section.settings.text_size_desktop }}px;
    --crt-text-size-mobile: {{ section.settings.text_size_mobile }}px;
    --crt-max-width: {{ section.settings.content_width }}px;
    background-color: var(--crt-bg);
    color: var(--crt-text);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    text-align: center;
  }

  #CustomRichtext-{{ section.id }} .custom-richtext__inner {
    width: 100%;
    max-width: var(--crt-max-width);
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  #CustomRichtext-{{ section.id }} .custom-richtext__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    margin: 0 0 28px;
    padding: 0.8rem 2rem;
    border-radius: 12px;
    background: var(--crt-badge-bg);
    color: var(--crt-badge-text);
    font-family: var(--font-body-family);
    font-size: 16px;
    font-weight: 600;
    line-height: 1.2;
    text-transform: uppercase;
}
  #CustomRichtext-{{ section.id }} .custom-richtext__stars {
    display: inline-flex;
    align-items: center;
    gap: 0.12rem;
    color: var(--crt-star);
    font-size: 2rem;
    line-height: 1;
  }

  #CustomRichtext-{{ section.id }} .custom-richtext__content {
    margin: 0;
    max-width: 100%;
    font-family: var(--font-body-family);
    font-size: var(--crt-text-size);
    font-weight: 400;
    line-height: 1.45;
    color: var(--crt-text);
  }

  #CustomRichtext-{{ section.id }} .custom-richtext__content p {
    margin: 0;
  }

  #CustomRichtext-{{ section.id }} .custom-richtext__content p + p {
    margin-top: 0.35em;
  }

  #CustomRichtext-{{ section.id }} .custom-richtext__content strong,
  #CustomRichtext-{{ section.id }} .custom-richtext__content b {
    font-weight: 700;
    color: var(--crt-strong);
  }

  @media screen and (max-width: 749px) {
    #CustomRichtext-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    #CustomRichtext-{{ section.id }} .custom-richtext__inner {
      padding: 0 1.25rem;
    }

    #CustomRichtext-{{ section.id }} .custom-richtext__badge {
      font-size: {{ section.settings.badge_size_mobile }}px;
      padding: 0.5rem 0.95rem;
      gap: 0.45rem;
    }

    #CustomRichtext-{{ section.id }} .custom-richtext__content {
      font-size: var(--crt-text-size-mobile);
      line-height: 1.5;
    }
  }
{% endstyle %}

<section
  id="CustomRichtext-{{ section.id }}"
  class="custom-richtext"
>
  <div class="custom-richtext__inner">
    {%- if section.settings.show_badge and section.settings.badge_text != blank -%}
      <div class="custom-richtext__badge">
        {%- if section.settings.show_stars -%}
          <span class="custom-richtext__stars" aria-hidden="true">★★★★★</span>
        {%- endif -%}
        <span>{{ section.settings.badge_text | escape }}</span>
      </div>
    {%- endif -%}

    {%- if section.settings.content != blank -%}
      <div class="custom-richtext__content rte">
        {{ section.settings.content }}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Custom Rich Text",
  "tag": "section",
  "class": "section-custom-richtext",
  "settings": [
    {
      "type": "header",
      "content": "Badge"
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show badge",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_stars",
      "label": "Show stars",
      "default": true
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "21K+ Happy Customers"
    },
    {
      "type": "range",
      "id": "badge_size_desktop",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Badge text size (desktop)",
      "default": 12
    },
    {
      "type": "range",
      "id": "badge_size_mobile",
      "min": 9,
      "max": 16,
      "step": 1,
      "unit": "px",
      "label": "Badge text size (mobile)",
      "default": 11
    },
    {
      "type": "range",
      "id": "badge_spacing",
      "min": 12,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Space below badge",
      "default": 28
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Text",
      "default": "<p>The Cold Life exists to redefine <strong>wellness through the power of water</strong><br/>by creating science-backed tools that support your recovery and transformations</p>"
    },
    {
      "type": "range",
      "id": "text_size_desktop",
      "min": 16,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Text size (desktop)",
      "default": 28
    },
    {
      "type": "range",
      "id": "text_size_mobile",
      "min": 14,
      "max": 28,
      "step": 1,
      "unit": "px",
      "label": "Text size (mobile)",
      "default": 20
    },
    {
      "type": "range",
      "id": "content_width",
      "min": 480,
      "max": 1100,
      "step": 20,
      "unit": "px",
      "label": "Content max width",
      "default": 820
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#0B1220"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#E8EDF5"
    },
    {
      "type": "color",
      "id": "strong_color",
      "label": "Bold text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "badge_background",
      "label": "Badge background",
      "default": "#1A2436"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Badge text",
      "default": "#D5DCE8"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star color",
      "default": "#F5C518"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Custom Rich Text",
      "category": "Custom Sections"
    }
  ]
}
{% endschema %}
