      "default": "left"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 24,
      "max": 56,
      "step": 2,
      "unit": "px",
      "label": "Heading size",
      "default": 36
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "min": 22,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Heading size (mobile)",
      "default": 28
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 13,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Text size",
      "default": 15
    },
    {
      "type": "range",
      "id": "text_size_mobile",
      "min": 13,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Text size (mobile)",
      "default": 14
    },
    {
      "type": "range",
      "id": "text_spacing",
      "min": 8,
      "max": 28,
      "step": 2,
      "unit": "px",
      "label": "Space below heading",
      "default": 12
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "range",
      "id": "button_size",
      "min": 11,
      "max": 16,
      "step": 1,
      "unit": "px",
      "label": "Button text size",
      "default": 13
    },
    {
      "type": "range",
      "id": "button_height",
      "min": 40,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Button height",
      "default": 52
    },
    {
      "type": "range",
      "id": "button_padding_x",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Button side padding",
      "default": 28
    },
    {
      "type": "range",
      "id": "button_radius",
      "min": 0,
      "max": 24,
      "step": 2,
