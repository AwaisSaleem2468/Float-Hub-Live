{% style %}
  #BecomeMember-{{ section.id }} {
    --bm-bg: {{ section.settings.background_color }};
    --bm-heading: {{ section.settings.heading_color }};
    --bm-text: {{ section.settings.text_color }};
    --bm-btn-bg: {{ section.settings.button_background }};
    --bm-btn-text: {{ section.settings.button_text_color }};
    --bm-btn-hover: {{ section.settings.button_hover_background }};
    background-color: var(--bm-bg);
    color: var(--bm-heading);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #BecomeMember-{{ section.id }} .become-member__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: {{ section.settings.content_gap }}px;
    width: 100%;
    max-width: {{ section.settings.content_width }}px;
    margin: 0 auto;
    padding: 0 {{ section.settings.padding_horizontal }}px;
    box-sizing: border-box;
  }

  #BecomeMember-{{ section.id }} .become-member__copy {
    flex: 1 1 auto;
    min-width: 0;
    max-width: {{ section.settings.text_max_width }}px;
  }

  #BecomeMember-{{ section.id }} .become-member__heading {
    margin: 0;
    color: var(--bm-heading);
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    font-size: {{ section.settings.heading_size }}px;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  #BecomeMember-{{ section.id }} .become-member__text {
    margin: {{ section.settings.text_spacing }}px 0 0;
    color: var(--bm-text);
    font-family: var(--font-body-family);
    font-size: {{ section.settings.text_size }}px;
    line-height: 1.55;
  }

  #BecomeMember-{{ section.id }} .become-member__text p {
    margin: 0;
  }

  #BecomeMember-{{ section.id }} .become-member__text p + p {
    margin-top: 0.5rem;
  }

  #BecomeMember-{{ section.id }} .become-member__actions {
    flex: 0 0 auto;
  }

  #BecomeMember-{{ section.id }} .become-member__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: {{ section.settings.button_height }}px;
    padding: 0.85rem {{ section.settings.button_padding_x }}px;
    border: 0;
    border-radius: {{ section.settings.button_radius }}px;
    background: var(--bm-btn-bg);
    color: var(--bm-btn-text);
    font-family: var(--font-body-family);
    font-size: {{ section.settings.button_size }}px;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.2;
    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;
    transition: background-color 0.2s ease, transform 0.2s ease, opacity 0.2s ease;
  }

  #BecomeMember-{{ section.id }} .become-member__btn:hover {
    background: var(--bm-btn-hover);
    transform: translateY(-1px);
  }

  #BecomeMember-{{ section.id }} .become-member__btn[aria-disabled='true'] {
    opacity: 0.55;
    pointer-events: none;
  }

  @media screen and (max-width: 749px) {
    #BecomeMember-{{ section.id }} .become-member__inner {
      flex-direction: column;
      align-items: stretch;
      gap: {{ section.settings.content_gap_mobile }}px;
      padding: 0 1.25rem;
      text-align: {{ section.settings.mobile_alignment }};
    }

    #BecomeMember-{{ section.id }} .become-member__copy {
      max-width: none;
    }

    #BecomeMember-{{ section.id }} .become-member__heading {
      font-size: {{ section.settings.heading_size_mobile }}px;
    }

    #BecomeMember-{{ section.id }} .become-member__text {
      font-size: {{ section.settings.text_size_mobile }}px;
    }

    #BecomeMember-{{ section.id }} .become-member__actions {
      width: 100%;
    }

    #BecomeMember-{{ section.id }} .become-member__btn {
      width: 100%;
      white-space: normal;
      text-align: center;
    }
  }
{% endstyle %}

<section
  id="BecomeMember-{{ section.id }}"
  class="become-member"
  aria-label="{{ section.settings.heading | default: 'Become a member' | escape }}"
>
  <div class="become-member__inner">
    <div class="become-member__copy">
      {%- if section.settings.heading != blank -%}
        <h2 class="become-member__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="become-member__text rte">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>

    {%- if section.settings.button_label != blank -%}
      <div class="become-member__actions">
        <a
          class="become-member__btn"
          {% if section.settings.button_link != blank %}
            href="{{ section.settings.button_link }}"
          {% else %}
            role="link"
            aria-disabled="true"
          {% endif %}
        >
          {{ section.settings.button_label | escape }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Custom Become a Member",
  "tag": "section",
  "class": "section-become-a-member",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Become a member"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Memberships offer the best price, no minimum term, free 90-min upgrades (subject to availability), and amazing partner benefits.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "CLICK FOR MEMBERSHIPS"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "content_width",
      "min": 700,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "label": "Content width",
      "default": 1200
    },
    {
      "type": "range",
      "id": "text_max_width",
      "min": 360,
      "max": 900,
      "step": 20,
      "unit": "px",
      "label": "Text max width",
      "default": 720
    },
    {
      "type": "range",
      "id": "content_gap",
      "min": 16,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Gap between text and button",
      "default": 40
    },
    {
      "type": "range",
      "id": "content_gap_mobile",
      "min": 12,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Gap (mobile)",
