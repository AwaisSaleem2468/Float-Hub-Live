{% style %}
  #Newsletter-{{ section.id }} {
    --nl-bg: {{ section.settings.background_color }};
    --nl-text: {{ section.settings.text_color }};
    --nl-muted: {{ section.settings.muted_color }};
    --nl-accent: {{ section.settings.accent_color }};
    --nl-input-bg: {{ section.settings.input_background }};
    --nl-input-border: {{ section.settings.input_border_color }};
    --nl-input-text: {{ section.settings.input_text_color }};
    background-color: var(--nl-bg);
    color: var(--nl-text);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #Newsletter-{{ section.id }} .newsletter-custom__inner {
    width: 100%;
    margin: 0 auto;
    box-sizing: border-box;
    text-align: center;
  }

  #Newsletter-{{ section.id }} .newsletter-custom__eyebrow {
    margin: 0 0 0.85rem;
    color: var(--nl-accent);
    font-family: var(--font-body-family);
    font-size: {{ section.settings.eyebrow_size }}px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  #Newsletter-{{ section.id }} .newsletter-custom__heading {
     margin: 0 auto 1rem;
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    font-size: 36px;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--nl-text);
    max-width: 660px;
}

  #Newsletter-{{ section.id }} .newsletter-custom__description {
    margin: 0 auto {{ section.settings.content_spacing }}px;
    max-width: {{ section.settings.text_max_width }}px;
    color: var(--nl-muted);
    font-family: var(--font-body-family);
    font-size: {{ section.settings.description_size }}px;
    line-height: 1.6;
  }

  #Newsletter-{{ section.id }} .newsletter-custom__description p {
    margin: 0;
  }

  #Newsletter-{{ section.id }} .newsletter-custom__description p + p {
    margin-top: 0.7rem;
  }

  #Newsletter-{{ section.id }} .newsletter-custom__form {
    width: 100%;
    max-width: {{ section.settings.form_width }}px;
    margin: 0 auto;
  }

  #Newsletter-{{ section.id }} .newsletter-custom__fields {
    display: flex;
    align-items: stretch;
    gap: {{ section.settings.form_gap }}px;
  }

  #Newsletter-{{ section.id }} .newsletter-custom__input-wrap {
    flex: 1 1 auto;
    min-width: 0;
  }

  #Newsletter-{{ section.id }} .newsletter-custom__input {
    width: 100%;
    min-height: 5.2rem;
    padding: 1.2rem 1.4rem;
    border: 1px solid var(--nl-input-border);
    border-radius: {{ section.settings.input_radius }}px;
    background: var(--nl-input-bg);
    color: var(--nl-input-text);
    font-family: var(--font-body-family);
    font-size: {{ section.settings.input_size }}px;
    line-height: 1.3;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  #Newsletter-{{ section.id }} .newsletter-custom__input::placeholder {
    color: color-mix(in srgb, var(--nl-input-text) 55%, transparent);
  }

  #Newsletter-{{ section.id }} .newsletter-custom__input:focus {
    border-color: var(--nl-accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--nl-accent) 25%, transparent);
  }

  #Newsletter-{{ section.id }} .newsletter-custom__button {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 5.2rem;
    padding: 1.2rem 2.4rem;
    border: 0;
    border-radius: {{ section.settings.button_radius }}px;
    background: linear-gradient(to right, #3b82f6, #22d3ee);
    color: #ffffff;
    font-family: var(--font-body-family);
    font-size: {{ section.settings.button_size }}px;
    font-weight: 600;
    line-height: 1.2;
    cursor: pointer;
    transition: transform 0.2s ease, filter 0.2s ease;
  }

  #Newsletter-{{ section.id }} .newsletter-custom__button:hover {
    transform: translateY(-1px);
    filter: brightness(1.05);
  }

  #Newsletter-{{ section.id }} .newsletter-custom__message {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin: 1rem 0 0;
    font-size: 1.4rem;
    line-height: 1.4;
  }

  #Newsletter-{{ section.id }} .newsletter-custom__message--error {
    color: #ff8f8f;
  }

  #Newsletter-{{ section.id }} .newsletter-custom__message--success {
    color: #7dffb3;
  }

  @media screen and (max-width: 749px) {
    #Newsletter-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.8 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.8 | round: 0 }}px;
    }
    #Newsletter-{{ section.id }} .newsletter-custom__heading {
      font-size: {{ section.settings.heading_size_mobile }}px;
    }

    #Newsletter-{{ section.id }} .newsletter-custom__fields {
      flex-direction: column;
    }

    #Newsletter-{{ section.id }} .newsletter-custom__button {
      width: 100%;
    }
  }
{% endstyle %}

<section id="Newsletter-{{ section.id }}" class="newsletter-custom">
  <div class="page-width newsletter-custom__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="newsletter-custom__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="newsletter-custom__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    {%- if section.settings.description != blank -%}
      <div class="newsletter-custom__description">
        {{ section.settings.description }}
      </div>
    {%- endif -%}

    {% form 'customer', class: 'newsletter-custom__form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">

      <div class="newsletter-custom__fields">
        <div class="newsletter-custom__input-wrap">
          <label class="visually-hidden" for="NewsletterForm--{{ section.id }}">
            {{ section.settings.email_placeholder | default: 'Email address' | escape }}
          </label>
          <input
            id="NewsletterForm--{{ section.id }}"
            class="newsletter-custom__input"
            type="email"
            name="contact[email]"
            value="{{ form.email }}"
            aria-required="true"
            autocorrect="off"
            autocapitalize="off"
            autocomplete="email"
            {% if form.errors %}
              autofocus
              aria-invalid="true"
              aria-describedby="Newsletter-error--{{ section.id }}"
            {% elsif form.posted_successfully? %}
              aria-describedby="Newsletter-success--{{ section.id }}"
            {% endif %}
            placeholder="{{ section.settings.email_placeholder | escape }}"
            required
          >
        </div>

        <button type="submit" class="newsletter-custom__button" name="commit">
          {{ section.settings.button_label | escape }}
        </button>
      </div>

      {%- if form.errors -%}
        <small class="newsletter-custom__message newsletter-custom__message--error" id="Newsletter-error--{{ section.id }}">
          {{- form.errors.translated_fields.email | capitalize }}
          {{ form.errors.messages.email -}}
        </small>
      {%- endif -%}

      {%- if form.posted_successfully? -%}
        <small class="newsletter-custom__message newsletter-custom__message--success" id="Newsletter-success--{{ section.id }}" tabindex="-1" autofocus>
          {{ section.settings.success_message | escape }}
        </small>
      {%- endif -%}
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Custom Newsletter",
  "tag": "section",
  "class": "section-custom-newsletter",
  "settings": [
    {
      "type": "header",
