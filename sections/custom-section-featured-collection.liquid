{% style %}
  #FeaturedPricing-{{ section.id }} {
    --fp-bg: {{ section.settings.background_color }};
    --fp-card-bg: {{ section.settings.card_background }};
    --fp-text: {{ section.settings.text_color }};
    --fp-muted: {{ section.settings.muted_color }};
    --fp-accent: {{ section.settings.accent_color }};
    --fp-accent-text: {{ section.settings.accent_text_color }};
    --fp-gold: {{ section.settings.gold_color }};
    --fp-gold-text: {{ section.settings.gold_text_color }};
    --fp-heading-size: {{ section.settings.heading_size_desktop }}px;
    --fp-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --fp-caption-size: {{ section.settings.caption_size }}px;
    --fp-title-size: {{ section.settings.title_size }}px;
    --fp-price-size: {{ section.settings.price_size }}px;
    --fp-feature-size: {{ section.settings.feature_size }}px;
    --fp-btn-size: {{ section.settings.button_size }}px;
    background-color: var(--fp-bg);
    color: var(--fp-text);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #FeaturedPricing-{{ section.id }} .featured-pricing__inner {
    width: 100%;
    max-width: {{ section.settings.content_width }}px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  #FeaturedPricing-{{ section.id }} .featured-pricing__header {
    text-align: center;
    max-width: 75rem;
    margin: 0 auto {{ section.settings.header_spacing }}px;
  }

  #FeaturedPricing-{{ section.id }} .featured-pricing__label {
    margin: 0 0 0.9rem;
    color: var(--fp-accent);
    font-family: var(--font-body-family);
    font-size: {{ section.settings.label_size }}px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  #FeaturedPricing-{{ section.id }} .featured-pricing__heading {
    margin: 0 0 1rem;
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    font-size: var(--fp-heading-size);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--fp-text);
  }

  #FeaturedPricing-{{ section.id }} .featured-pricing__heading-accent {
    display: block;
    color: var(--fp-gold);
  }

  #FeaturedPricing-{{ section.id }} .featured-pricing__description {
    margin: 0;
    color: var(--fp-muted);
    font-size: {{ section.settings.description_size_desktop }}px;
    line-height: 1.55;
  }

  #FeaturedPricing-{{ section.id }} .featured-pricing__description p {
    margin: 0;
  }

  #FeaturedPricing-{{ section.id }} .featured-pricing__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.6rem;
  }

  #FeaturedPricing-{{ section.id }} .featured-pricing__card {
        position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 3rem 2rem;
    border-radius: 1.2rem;
    background: var(--fp-card-bg);
    border: 1px solid rgba(255, 255, 255, 0.08);
    gap: 1rem;
  }

  #FeaturedPricing-{{ section.id }} .featured-pricing__card--featured {
    border-color: var(--fp-accent);
    box-shadow: 0 0 0 1px var(--fp-accent);
  }

  #FeaturedPricing-{{ section.id }} .featured-pricing__badge {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translate(-50%, -50%);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem 1rem;
    border-radius: 8px;
    background: linear-gradient(to right, #3b82f6, #22d3ee);
    color: #ffffff;
    font-size: 1rem;
    font-weight: 700;
    white-space: nowrap;
  }

  #FeaturedPricing-{{ section.id }} .featured-pricing__eyebrow {
    margin: 0 0 0.5rem;
    color: var(--fp-muted);
    font-family: var(--font-body-family);
    font-size: var(--fp-caption-size);
    line-height: 1.35;
  }

  #FeaturedPricing-{{ section.id }} .featured-pricing__title {
    margin: 0 0 0.75rem;
    font-family: var(--font-body-family);
    font-size: var(--fp-title-size);
    font-weight: 700;
    line-height: 1.2;
    color: var(--fp-text);
  }

  #FeaturedPricing-{{ section.id }} .featured-pricing__price-row {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.35rem 0.5rem;
    margin: 0 0 1.25rem;
  }

  #FeaturedPricing-{{ section.id }} .featured-pricing__price {
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    font-size: var(--fp-price-size);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--fp-text);
  }

  #FeaturedPricing-{{ section.id }} .featured-pricing__price-note {
    color: var(--fp-muted);
    font-size: 0.95rem;
    line-height: 1.2;
  }

  #FeaturedPricing-{{ section.id }} .featured-pricing__features {
    list-style: none;
    margin: 1rem 0;
    padding: 0;
    gap: 0.7rem;
    flex: 1 1 auto;
  }

  #FeaturedPricing-{{ section.id }} .featured-pricing__feature {
    display: flex;
    align-items: flex-start;
    gap: 0.8rem;
    margin: 0 0 1rem;
    color: rgba(255, 255, 255, 0.9);
    font-family: var(--font-body-family);
    font-size: var(--fp-feature-size);
    line-height: 1.4;
  }

  #FeaturedPricing-{{ section.id }} .featured-pricing__check {
   flex-shrink: 0;
    width: 1.6rem;
    height: 1.6rem;
    margin-top: 0.5rem;
    color: var(--fp-accent);
  }

  #FeaturedPricing-{{ section.id }} .featured-pricing__check svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  #FeaturedPricing-{{ section.id }} .featured-pricing__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 3.1rem;
    padding: 0.85rem 1.25rem;
    border: 1px solid transparent;
    border-radius: 0.7rem;
    background: linear-gradient(to right, #3b82f6, #22d3ee);
    color: #ffffff;
    font-family: var(--font-body-family);
    font-size: var(--fp-btn-size);
    font-weight: 600;
    text-decoration: none;
    transition: transform 0.2s ease, filter 0.2s ease;
    cursor: pointer;
  }

  #FeaturedPricing-{{ section.id }} .featured-pricing__btn:hover {
    transform: translateY(-1px);
    filter: brightness(1.05);
  }

  #FeaturedPricing-{{ section.id }} .featured-pricing__view-all {
    display: flex;
    justify-content: center;
    margin-top: {{ section.settings.view_all_spacing }}px;
  }

  #FeaturedPricing-{{ section.id }} .featured-pricing__view-all-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3.1rem;
    padding: 0.85rem 1.8rem;
    border-radius: 0.7rem;
    font-family: var(--font-body-family);
    font-size: var(--fp-btn-size);
    font-weight: 600;
    text-decoration: none;
    transition: transform 0.2s ease, background-color 0.2s ease, border-color 0.2s ease, filter 0.2s ease;
  }

  #FeaturedPricing-{{ section.id }} .featured-pricing__view-all-btn:hover {
    transform: translateY(-1px);
  }

  #FeaturedPricing-{{ section.id }} .featured-pricing__view-all-btn--ghost {
    background: transparent;
    color: var(--fp-text);
    border: 1px solid rgba(255, 255, 255, 0.28);
  }

  #FeaturedPricing-{{ section.id }} .featured-pricing__view-all-btn--ghost:hover {
    border-color: rgba(255, 255, 255, 0.55);
    background: rgba(255, 255, 255, 0.04);
  }

  #FeaturedPricing-{{ section.id }} .featured-pricing__view-all-btn--solid {
    background: linear-gradient(to right, #3b82f6, #22d3ee);
    color: #ffffff;
    border: 1px solid transparent;
  }

  #FeaturedPricing-{{ section.id }} .featured-pricing__view-all-btn--solid:hover {
    filter: brightness(1.05);
  }

  @media screen and (max-width: 989px) {
    #FeaturedPricing-{{ section.id }} .featured-pricing__grid {
      grid-template-columns: 1fr;
    }
  }

  @media screen and (max-width: 749px) {
    #FeaturedPricing-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    #FeaturedPricing-{{ section.id }} .featured-pricing__inner {
      padding: 0 1.25rem;
    }

    #FeaturedPricing-{{ section.id }} .featured-pricing__heading {
      font-size: var(--fp-heading-size-mobile);
    }

    #FeaturedPricing-{{ section.id }} .featured-pricing__description {
      font-size: {{ section.settings.description_size_mobile }}px;
    }

    #FeaturedPricing-{{ section.id }} .featured-pricing__title {
      font-size: calc(var(--fp-title-size) * 0.95);
    }

    #FeaturedPricing-{{ section.id }} .featured-pricing__price {
      font-size: calc(var(--fp-price-size) * 0.85);
    }
  }
{% endstyle %}

{%- capture check_icon -%}
  <span class="featured-pricing__check" aria-hidden="true">
    <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M3.2 8.2l3 3 6.6-6.8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </span>
{%- endcapture -%}

<section id="FeaturedPricing-{{ section.id }}" class="featured-pricing">
  <div class="page-width">
    <div class="featured-pricing__header">
      {%- if section.settings.label != blank -%}
        <p class="featured-pricing__label">{{ section.settings.label | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank or section.settings.heading_accent != blank -%}
        <h2 class="featured-pricing__heading">
          {%- if section.settings.heading != blank -%}
            <span>{{ section.settings.heading | escape }}</span>
          {%- endif -%}
          {%- if section.settings.heading_accent != blank -%}
            <span class="featured-pricing__heading-accent">{{ section.settings.heading_accent | escape }}</span>
          {%- endif -%}
        </h2>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <div class="featured-pricing__description rte">
          {{ section.settings.description }}
        </div>
      {%- endif -%}
    </div>

    {%- assign plan_blocks = section.blocks | where: 'type', 'product_card' -%}
    {%- if plan_blocks.size > 0 -%}
      <div class="featured-pricing__grid">
        {%- for block in plan_blocks -%}
          {%- liquid
            assign card_product = block.settings.product
            assign is_featured = block.settings.featured
            assign caption = blank
            assign features_metafield = blank
            assign button_label = block.settings.button_label
            assign button_link = block.settings.button_link
            assign price_note = block.settings.price_note
            assign price_override = block.settings.price_override

            if card_product != blank
              assign caption_metafield = card_product.metafields.custom.product_caption
              assign features_metafield = card_product.metafields.custom.product_key_feature

              if caption_metafield != blank
                assign caption = caption_metafield.value | default: caption_metafield
              endif

              if button_link == blank
                if block.settings.redirect_to_checkout and card_product.selected_or_first_available_variant != blank
                  assign variant_id = card_product.selected_or_first_available_variant.id
                  assign button_link = routes.cart_add_url | append: '?id=' | append: variant_id | append: '&quantity=1&return_to=/checkout'
                else
                  assign button_link = card_product.url
                endif
              endif
              if button_label == blank
                assign button_label = 'Book Now'
              endif
            endif
          -%}

          {%- if card_product != blank -%}
            <article
              class="featured-pricing__card{% if is_featured %} featured-pricing__card--featured{% endif %}"
              {{ block.shopify_attributes }}
            >
              {%- if is_featured and block.settings.badge_text != blank -%}
                <span class="featured-pricing__badge">{{ block.settings.badge_text | escape }}</span>
              {%- endif -%}

              {%- if caption != blank -%}
                <p class="featured-pricing__eyebrow">{{ caption | escape }}</p>
              {%- endif -%}

              <h3 class="featured-pricing__title">{{ card_product.title | escape }}</h3>

              <div class="featured-pricing__price-row">
                <span class="featured-pricing__price">
                  {%- if price_override != blank -%}
                    {{ price_override | escape }}
                  {%- else -%}
                    {{ card_product.price | money }}
                  {%- endif -%}
                </span>
                {%- if price_note != blank -%}
                  <span class="featured-pricing__price-note">{{ price_note | escape }}</span>
                {%- endif -%}
              </div>

              {%- if features_metafield != blank and features_metafield.value != blank -%}
                <ul class="featured-pricing__features">
                  {%- if features_metafield.type contains 'list.' -%}
                    {%- for feature in features_metafield.value -%}
                      {%- assign feature_text = feature | strip -%}
                      {%- if feature_text != blank -%}
                        <li class="featured-pricing__feature">
                          {{ check_icon }}
                          <span>{{ feature_text | escape }}</span>
                        </li>
                      {%- endif -%}
                    {%- endfor -%}
                  {%- else -%}
                    {%- assign feature_raw = features_metafield | metafield_text | default: features_metafield.value -%}
                    {%- capture feature_lines -%}
                      {{- feature_raw | newline_to_br -}}
                    {%- endcapture -%}
                    {%- assign features = feature_lines | split: '<br />' -%}
                    {%- if features.size == 1 -%}
                      {%- assign features = feature_lines | split: '<br/>' -%}
                    {%- endif -%}
                    {%- for feature in features -%}
                      {%- assign feature_text = feature | strip_html | strip -%}
                      {%- if feature_text != blank -%}
                        <li class="featured-pricing__feature">
                          {{ check_icon }}
                          <span>{{ feature_text | escape }}</span>
                        </li>
                      {%- endif -%}
                    {%- endfor -%}
                  {%- endif -%}
                </ul>
              {%- endif -%}

              {%- if button_label != blank -%}
                <a class="featured-pricing__btn" href="{{ button_link }}">
                  {{ button_label | escape }}
                </a>
              {%- endif -%}
            </article>
          {%- else -%}
            <article class="featured-pricing__card" {{ block.shopify_attributes }}>
              <p class="featured-pricing__eyebrow">Select a product</p>
              <h3 class="featured-pricing__title">Product card</h3>
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.show_view_all and section.settings.view_all_label != blank -%}
      <div class="featured-pricing__view-all">
        <a
          class="featured-pricing__view-all-btn featured-pricing__view-all-btn--{{ section.settings.view_all_style }}"
          {% if section.settings.view_all_link != blank %}
            href="{{ section.settings.view_all_link }}"
          {% else %}
            role="link"
            aria-disabled="true"
          {% endif %}
        >
          {{ section.settings.view_all_label | escape }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Custom Feat collection",
  "tag": "section",
  "class": "section-custom-featured-collection",
  "settings": [
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Eyebrow label",
      "default": "Transparent Pricing"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "No hidden costs."
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading accent line",
      "default": "No contracts."
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "min": 28,
      "max": 72,
      "step": 2,
      "unit": "px",
      "label": "Heading size (desktop)",
      "default": 52
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "min": 24,
      "max": 48,
      "step": 1,
      "unit": "px",
      "label": "Heading size (mobile)",
      "default": 34
    },
    {
      "type": "range",
      "id": "label_size",
      "min": 10,
      "max": 16,
      "step": 1,
      "unit": "px",
      "label": "Eyebrow size",
      "default": 12
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Start with a single session or save with our intro pack. Cancel your membership any time.</p>"
    },
    {
      "type": "range",
      "id": "description_size_desktop",
      "min": 13,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "Description size (desktop)",
      "default": 16
    },
    {
      "type": "range",
      "id": "description_size_mobile",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Description size (mobile)",
      "default": 15
    },
    {
      "type": "header",
      "content": "Card typography"
    },
    {
      "type": "range",
      "id": "caption_size",
      "min": 11,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Caption size",
      "default": 14
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 16,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Product title size",
      "default": 22
    },
    {
      "type": "range",
      "id": "price_size",
      "min": 28,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Price size",
      "default": 48
    },
    {
      "type": "range",
      "id": "feature_size",
      "min": 12,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Feature list size",
      "default": 15
    },
    {
      "type": "range",
      "id": "button_size",
      "min": 12,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Button text size",
      "default": 15
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "content_width",
      "min": 900,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "label": "Content max width",
      "default": 1120
    },
    {
      "type": "range",
      "id": "header_spacing",
      "min": 24,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Space below header",
      "default": 48
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#070D16"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#121A27"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Muted text",
      "default": "#A8B0BD"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent (cyan)",
      "default": "#0DAAEF"
    },
    {
      "type": "color",
      "id": "accent_text_color",
      "label": "Accent button text",
      "default": "#061018"
    },
    {
      "type": "color",
      "id": "gold_color",
      "label": "Gold accent",
      "default": "#C9A46A"
    },
    {
      "type": "color",
      "id": "gold_text_color",
      "label": "Gold button text",
      "default": "#1A1208"
    },
    {
      "type": "header",
      "content": "View all button"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show view all button",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "Button label",
      "default": "View all"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "view_all_style",
      "label": "Button style",
      "options": [
        {
          "value": "ghost",
          "label": "Outline"
        },
        {
          "value": "solid",
          "label": "Solid"
        }
      ],
      "default": "ghost"
    },
    {
      "type": "range",
      "id": "view_all_spacing",
      "min": 16,
      "max": 64,
      "step": 4,
      "unit": "px",
      "label": "Space above button",
      "default": 32
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product card",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product",
          "info": "Uses product title, price, custom.product_caption, and custom.product_key_feature."
        },
        {
          "type": "checkbox",
          "id": "featured",
          "label": "Highlight as most popular",
          "default": false
        },
        {
          "type": "text",
          "id": "badge_text",
          "label": "Featured badge text",
          "default": "Most Popular"
        },
        {
          "type": "text",
          "id": "price_override",
          "label": "Price override",
          "info": "Optional. Leave blank to use the product price. Example: £99 or From £45"
        },
        {
          "type": "text",
          "id": "price_note",
          "label": "Price note",
          "info": "Optional text after price, e.g. / month or / 2 floats"
        },
        {
          "type": "text",
