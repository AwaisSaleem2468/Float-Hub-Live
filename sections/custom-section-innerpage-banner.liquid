      ],
      "default": "middle"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center",
      "info": "Alignment of heading, text, and buttons."
    },
    {
      "type": "range",
      "id": "content_width",
      "min": 700,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "label": "Content max width",
      "default": 1200,
      "info": "Capped by the theme page-width container."
    }
  ],
  "presets": [
    {
      "name": "Custom Innerpage Banner",
      "category": "Custom Sections"
    }
  ]
}
{% endschema %}
