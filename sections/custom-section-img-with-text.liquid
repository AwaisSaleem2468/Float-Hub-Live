{% style %}
  #CustomImgText-{{ section.id }} {
    --cit-bg: {{ section.settings.background_color }};
    --cit-text: {{ section.settings.text_color }};
    --cit-muted: {{ section.settings.muted_color }};
    --cit-accent: {{ section.settings.accent_color }};
    --cit-heading-size: {{ section.settings.heading_size_desktop }}px;
    --cit-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    background-color: var(--cit-bg);
    color: var(--cit-text);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #CustomImgText-{{ section.id }} .custom-img-text__inner {
    display: grid;
    grid-template-columns: {% if section.settings.image_width == 'small' %}0.85fr 1.15fr{% elsif section.settings.image_width == 'large' %}1.15fr 0.85fr{% else %}1fr 1fr{% endif %};
    gap: clamp(2rem, 4vw, 3.2rem);
    align-items: {{ section.settings.desktop_content_position }};
  }

  #CustomImgText-{{ section.id }} .custom-img-text__inner--image-right {
    grid-template-columns: {% if section.settings.image_width == 'small' %}1.15fr 0.85fr{% elsif section.settings.image_width == 'large' %}0.85fr 1.15fr{% else %}1fr 1fr{% endif %};
  }

  #CustomImgText-{{ section.id }} .custom-img-text__inner--image-right .custom-img-text__media {
    order: 2;
  }

  #CustomImgText-{{ section.id }} .custom-img-text__inner--image-right .custom-img-text__content {
    order: 1;
  }

  #CustomImgText-{{ section.id }} .custom-img-text__content {
    text-align: {{ section.settings.content_alignment }};
  }

  #CustomImgText-{{ section.id }} .custom-img-text__subtitle {
    margin: 0 0 0.85rem;
    color: var(--cit-accent);
    font-family: var(--font-body-family);
    font-size: {{ section.settings.subtitle_size }}px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  #CustomImgText-{{ section.id }} .custom-img-text__heading {
    margin: 0 0 1rem;
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    font-size: var(--cit-heading-size);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--cit-text);
  }

  #CustomImgText-{{ section.id }} .custom-img-text__heading-accent {
    color: var(--cit-accent);
  }

  #CustomImgText-{{ section.id }} .custom-img-text__description {
    margin: 0 0 1.75rem;
    color: var(--cit-muted);
    font-size: {{ section.settings.description_size }}px;
    line-height: 1.6;
  }

  #CustomImgText-{{ section.id }} .custom-img-text__description p {
    margin: 0;
  }

  #CustomImgText-{{ section.id }} .custom-img-text__description p + p {
    margin-top: 0.85rem;
  }

  #CustomImgText-{{ section.id }} .custom-img-text__description a {
    color: var(--cit-accent);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  #CustomImgText-{{ section.id }} .custom-img-text__description a:hover {
    filter: brightness(1.1);
  }

  #CustomImgText-{{ section.id }} .custom-img-text__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    {% if section.settings.content_alignment == 'center' %}
      justify-content: center;
    {% elsif section.settings.content_alignment == 'right' %}
      justify-content: flex-end;
    {% else %}
      justify-content: flex-start;
    {% endif %}
  }

  #CustomImgText-{{ section.id }} .custom-img-text__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    min-height: 5.2rem;
    padding: 1.5rem 2.5rem;
    border-radius: {{ section.settings.button_radius }}px;
    font-family: var(--font-body-family);
    font-size: {{ section.settings.button_size }}px;
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
    transition: transform 0.2s ease, filter 0.2s ease, background-color 0.2s ease, border-color 0.2s ease;
  }

  #CustomImgText-{{ section.id }} .custom-img-text__btn:hover {
    transform: translateY(-1px);
  }

  #CustomImgText-{{ section.id }} .custom-img-text__btn--primary {
    background: linear-gradient(to right, #3b82f6, #22d3ee);
    color: #ffffff;
    border: 1px solid transparent;
  }

  #CustomImgText-{{ section.id }} .custom-img-text__btn--primary:hover {
    filter: brightness(1.05);
  }

  #CustomImgText-{{ section.id }} .custom-img-text__btn--secondary {
    background: transparent;
    color: var(--cit-text);
    border: 1px solid rgba(255, 255, 255, 0.35);
  }

  #CustomImgText-{{ section.id }} .custom-img-text__btn--secondary:hover {
    border-color: rgba(255, 255, 255, 0.65);
    background: rgba(255, 255, 255, 0.04);
  }

  #CustomImgText-{{ section.id }} .custom-img-text__media {
    width: 100%;
    min-width: 0;
  }

  #CustomImgText-{{ section.id }} .custom-img-text__image {
    display: block;
    width: 100%;
    height: auto;
    max-width: 100%;
    border-radius: {{ section.settings.image_radius }}px;
    background: #101826;
  }

  #CustomImgText-{{ section.id }} .custom-img-text__image--cover {
    height: {{ section.settings.image_fixed_height }}px;
    object-fit: cover;
  }

  #CustomImgText-{{ section.id }} .custom-img-text__placeholder {
    width: 100%;
    aspect-ratio: 4 / 5;
    border-radius: {{ section.settings.image_radius }}px;
    background: linear-gradient(160deg, #152033 0%, #0b1220 100%);
  }

  @media screen and (max-width: 989px) {
    #CustomImgText-{{ section.id }} .custom-img-text__inner,
    #CustomImgText-{{ section.id }} .custom-img-text__inner--image-right {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    #CustomImgText-{{ section.id }} .custom-img-text__inner--image-right .custom-img-text__media,
    #CustomImgText-{{ section.id }} .custom-img-text__inner--image-left .custom-img-text__media {
      order: {% if section.settings.mobile_image_first %} -1 {% else %} 2 {% endif %};
    }

    #CustomImgText-{{ section.id }} .custom-img-text__content {
      order: {% if section.settings.mobile_image_first %} 2 {% else %} 1 {% endif %};
      text-align: {{ section.settings.mobile_content_alignment }};
    }

    #CustomImgText-{{ section.id }} .custom-img-text__actions {
      {% if section.settings.mobile_content_alignment == 'center' %}
        justify-content: center;
      {% elsif section.settings.mobile_content_alignment == 'right' %}
        justify-content: flex-end;
      {% else %}
        justify-content: flex-start;
      {% endif %}
    }

    #CustomImgText-{{ section.id }} .custom-img-text__image--cover {
      height: auto;
      aspect-ratio: 4 / 5;
    }
  }

  @media screen and (max-width: 749px) {
    #CustomImgText-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    #CustomImgText-{{ section.id }} .custom-img-text__inner {
      padding: 0 1.25rem;
    }

    #CustomImgText-{{ section.id }} .custom-img-text__heading {
      font-size: var(--cit-heading-size-mobile);
    }

    #CustomImgText-{{ section.id }} .custom-img-text__actions {
      flex-direction: column;
      align-items: {% if section.settings.mobile_content_alignment == 'center' %}center{% elsif section.settings.mobile_content_alignment == 'right' %}flex-end{% else %}stretch{% endif %};
    }

    #CustomImgText-{{ section.id }} .custom-img-text__btn {
      width: {% if section.settings.mobile_content_alignment == 'left' %}100%{% else %}auto{% endif %};
      min-width: {% if section.settings.mobile_content_alignment == 'left' %}0{% else %}12rem{% endif %};
    }
  }
{% endstyle %}

<section id="CustomImgText-{{ section.id }}" class="custom-img-text">
  <div class="page-width custom-img-text__inner custom-img-text__inner--image-{{ section.settings.layout }}">
    <div class="custom-img-text__media">
      {%- if section.settings.image != blank -%}
        {%- liquid
          assign image_class = 'custom-img-text__image'
          if section.settings.image_height == 'fixed'
            assign image_class = image_class | append: ' custom-img-text__image--cover'
          endif
        -%}
        {{
          section.settings.image
          | image_url: width: 1600
          | image_tag:
            class: image_class,
            widths: '600, 900, 1200, 1600',
            sizes: '(min-width: 990px) 42vw, 100vw',
            loading: 'lazy'
        }}
      {%- else -%}
        <div class="custom-img-text__placeholder"></div>
      {%- endif -%}
    </div>

    <div class="custom-img-text__content">
      {%- if section.settings.subtitle != blank -%}
        <p class="custom-img-text__subtitle">{{ section.settings.subtitle | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank or section.settings.heading_accent != blank -%}
        <h2 class="custom-img-text__heading">
          {%- if section.settings.heading != blank -%}
            <span>{{ section.settings.heading | escape }}</span>
          {%- endif -%}
          {%- if section.settings.heading_accent != blank -%}
            <span class="custom-img-text__heading-accent"> {{ section.settings.heading_accent | escape }}</span>
          {%- endif -%}
        </h2>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <div class="custom-img-text__description rte">
          {{ section.settings.description }}
        </div>
      {%- endif -%}

      {%- if section.settings.button_label_1 != blank or section.settings.button_label_2 != blank -%}
        <div class="custom-img-text__actions">
          {%- if section.settings.button_label_1 != blank -%}
            {%- capture button_href_1 -%}
              {%- render 'product-cta-url',
                link: section.settings.button_link_1,
                product: section.settings.button_product_1,
                redirect_to_checkout: section.settings.button_redirect_checkout_1
              -%}
            {%- endcapture -%}
            {%- assign button_href_1 = button_href_1 | strip -%}
            <a
              class="custom-img-text__btn custom-img-text__btn--primary"
              {% if button_href_1 != blank %}
                href="{{ button_href_1 }}"
              {% else %}
                role="link"
                aria-disabled="true"
              {% endif %}
            >
              {{ section.settings.button_label_1 | escape }}
            </a>
          {%- endif -%}

          {%- if section.settings.button_label_2 != blank -%}
            {%- capture button_href_2 -%}
              {%- render 'product-cta-url',
                link: section.settings.button_link_2,
                product: section.settings.button_product_2,
                redirect_to_checkout: section.settings.button_redirect_checkout_2
              -%}
            {%- endcapture -%}
            {%- assign button_href_2 = button_href_2 | strip -%}
            <a
              class="custom-img-text__btn custom-img-text__btn--secondary"
              {% if button_href_2 != blank %}
                href="{{ button_href_2 }}"
              {% else %}
                role="link"
                aria-disabled="true"
              {% endif %}
            >
              {{ section.settings.button_label_2 | escape }}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Custom Img with text",
  "tag": "section",
  "class": "section-custom-img-with-text",
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Image placement",
      "options": [
        { "value": "left", "label": "Image left" },
        { "value": "right", "label": "Image right" }
      ],
      "default": "right"
    },
    {
      "type": "select",
      "id": "image_width",
      "label": "Image width",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "image_height",
      "label": "Image height",
      "options": [
        { "value": "adapt", "label": "Adapt to image" },
        { "value": "fixed", "label": "Fixed height" }
      ],
      "default": "adapt"
    },
    {
      "type": "range",
      "id": "image_fixed_height",
      "min": 280,
      "max": 700,
      "step": 20,
      "unit": "px",
      "label": "Fixed image height",
      "default": 520,
      "info": "Used when image height is set to Fixed height."
    },
    {
      "type": "range",
      "id": "image_radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Image corner radius",
      "default": 20
    },
    {
      "type": "checkbox",
      "id": "mobile_image_first",
      "label": "Show image first on mobile",
      "default": true
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Why Float?"
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "min": 10,
      "max": 16,
      "step": 1,
      "unit": "px",
      "label": "Subtitle size",
      "default": 12
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Title",
      "default": "Your mind and body know what to do—"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Title accent",
      "default": "when given space."
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "min": 24,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Title size (desktop)",
      "default": 40
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "min": 22,
      "max": 42,
      "step": 1,
      "unit": "px",
      "label": "Title size (mobile)",
      "default": 30
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Floating helps you pause, reset, and reconnect. Start with a few sessions and feel the benefits compound over time.</p>"
    },
    {
      "type": "range",
      "id": "description_size",
      "min": 13,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Description size",
      "default": 16
    },
    {
      "type": "select",
      "id": "desktop_content_position",
      "label": "Desktop vertical alignment",
      "options": [
        { "value": "start", "label": "Top" },
        { "value": "center", "label": "Middle" },
        { "value": "end", "label": "Bottom" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Desktop content alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "mobile_content_alignment",
      "label": "Mobile content alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "button_label_1",
      "label": "Primary button label",
      "default": "Book Now"
    },
    {
      "type": "product",
      "id": "button_product_1",
      "label": "Primary button product",
      "info": "Optional. Used when no custom link is set."
    },
    {
      "type": "checkbox",
      "id": "button_redirect_checkout_1",
      "label": "Primary button redirect to checkout",
      "default": false,
      "info": "If a product is selected, skip the product page and go straight to checkout."
    },
    {
      "type": "url",
      "id": "button_link_1",
      "label": "Primary button link",
      "info": "Optional override. Takes priority over product / checkout."
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Secondary button label",
      "default": "Learn More"
    },
    {
      "type": "product",
      "id": "button_product_2",
      "label": "Secondary button product",
      "info": "Optional. Used when no custom link is set."
    },
    {
      "type": "checkbox",
      "id": "button_redirect_checkout_2",
      "label": "Secondary button redirect to checkout",
      "default": false,
      "info": "If a product is selected, skip the product page and go straight to checkout."
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Secondary button link",
      "info": "Optional override. Takes priority over product / checkout."
    },
    {
      "type": "range",
      "id": "button_size",
      "min": 14,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "Button text size",
      "default": 16
    },
    {
      "type": "range",
      "id": "button_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Button corner radius",
      "default": 10
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#070D16"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Description text",
      "default": "#A8B0BD"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Subtitle / title accent",
      "default": "#0DAAEF"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "content_width",
      "min": 1000,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "label": "Content max width",
      "default": 1200
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Custom Img with text",
      "category": "Custom Sections"
    }
  ]
}
{% endschema %}
