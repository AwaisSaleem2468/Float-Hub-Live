{% style %}
  #FloatBenefits-{{ section.id }} {
    --fb-bg: {{ section.settings.background_color }};
    --fb-text: {{ section.settings.text_color }};
    --fb-muted: {{ section.settings.muted_color }};
    --fb-accent: {{ section.settings.accent_color }};
    --fb-accent-text: {{ section.settings.accent_text_color }};
    --fb-card: {{ section.settings.card_background }};
    --fb-heading-size: {{ section.settings.heading_size_desktop }}px;
    --fb-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    background-color: var(--fb-bg);
    color: var(--fb-text);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #FloatBenefits-{{ section.id }} .float-benefits__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(1rem, 4vw, 2.5rem);
    align-items: center;
  }

  #FloatBenefits-{{ section.id }} .float-benefits__label {
    margin: 0 0 0.85rem;
    color: var(--fb-accent);
    font-family: var(--font-body-family);
    font-size: {{ section.settings.label_size }}px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  #FloatBenefits-{{ section.id }} .float-benefits__heading {
    margin: 0 0 2rem;
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    font-size: var(--fb-heading-size);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--fb-text);
  }

  #FloatBenefits-{{ section.id }} .float-benefits__heading-accent {
    color: var(--fb-accent);
  }

  #FloatBenefits-{{ section.id }} .float-benefits__description {
    margin: 0 0 2.5rem;
    color: var(--fb-muted);
    font-size: {{ section.settings.description_size }}px;
    line-height: 1.6;
  }

  #FloatBenefits-{{ section.id }} .float-benefits__description p {
    margin: 0;
  }

  #FloatBenefits-{{ section.id }} .float-benefits__tabs {
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    gap: 0.5rem;
    margin: 0 0 2.5rem;
    padding-bottom: 0;
    border-bottom: 1px solid color-mix(in srgb, var(--fb-accent) 45%, transparent);
  }

  #FloatBenefits-{{ section.id }} .float-benefits__tab {
    flex: 1 1 0;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
    min-height: 6.4rem;
    padding: 1rem 0.75rem 0.95rem;
    border: 0;
    border-radius: 0.85rem 0.85rem 0 0;
    background: transparent;
    color: #8B93A1;
    font-family: var(--font-body-family);
    font-size: 1.8rem;
    font-weight: 700;
    text-transform: none;
    cursor: pointer;
    transition: background 0.25s ease, color 0.25s ease, box-shadow 0.25s ease, transform 0.25s ease;
  }

  #FloatBenefits-{{ section.id }} .float-benefits__tab:hover {
    color: #C5CCD6;
  }

  #FloatBenefits-{{ section.id }} .float-benefits__tab[aria-selected='true'] {
    background: linear-gradient(to right, #3b82f6, #22d3ee);
    color: #ffffff;
    box-shadow: 0 10px 24px rgba(59, 130, 246, 0.35);
    transform: translateY(-2px);
  }

  #FloatBenefits-{{ section.id }} .float-benefits__tab-icon {
    display: inline-flex;
    width: 4rem;
    height: 4rem;
    flex-shrink: 0;
    color: #ffffff;
  }

  #FloatBenefits-{{ section.id }} .float-benefits__tab-icon img,
  #FloatBenefits-{{ section.id }} .float-benefits__tab-icon svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  #FloatBenefits-{{ section.id }} .float-benefits__tab-icon img {
    filter: brightness(0) invert(1);
  }

  #FloatBenefits-{{ section.id }} .float-benefits__tab[aria-selected='true'] .float-benefits__tab-icon {
    color: #ffffff;
  }

  #FloatBenefits-{{ section.id }} .float-benefits__panel {
    display: none;
  }

  #FloatBenefits-{{ section.id }} .float-benefits__panel.is-active {
    display: block;
  }

  #FloatBenefits-{{ section.id }} .float-benefits__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2.2rem;
  }

  #FloatBenefits-{{ section.id }} .float-benefits__item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.2rem;
    align-items: flex-start;
  }

  #FloatBenefits-{{ section.id }} .float-benefits__item-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.1);
    color: #ffffff;
    flex-shrink: 0;
  }

  #FloatBenefits-{{ section.id }} .float-benefits__item-icon img,
  #FloatBenefits-{{ section.id }} .float-benefits__item-icon svg {
    display: block;
    width: 3.2rem;
    height: 3.2rem;
    object-fit: contain;
    color: #ffffff;
  }

  #FloatBenefits-{{ section.id }} .float-benefits__item-icon svg,
  #FloatBenefits-{{ section.id }} .float-benefits__item-icon svg * {
    stroke: #ffffff !important;
    color: #ffffff !important;
  }

  #FloatBenefits-{{ section.id }} .float-benefits__item-icon img {
    filter: brightness(0) invert(1);
  }

  #FloatBenefits-{{ section.id }} .float-benefits__item-title {
    margin: 0 0 0.2rem;
    font-family: var(--font-body-family);
    font-size: {{ section.settings.benefit_title_size }}px;
    font-weight: 700;
    line-height: 1.3;
    color: var(--fb-text);
  }

  #FloatBenefits-{{ section.id }} .float-benefits__item-text {
    margin: 0;
    color: var(--fb-muted);
    font-size: {{ section.settings.benefit_text_size }}px;
    line-height: 1.5;
  }

  #FloatBenefits-{{ section.id }} .float-benefits__media {
    position: relative;
    width: 100%;
  }

  #FloatBenefits-{{ section.id }} .float-benefits__image {
    display: block;
    width: 100%;
    height: auto;
    max-width: 100%;
    object-fit: contain;
    border-radius: 1.25rem;
    background: #101826;
  }

  #FloatBenefits-{{ section.id }} .float-benefits__image-placeholder {
    width: 100%;
    aspect-ratio: 4 / 5;
    border-radius: 1.25rem;
    background: linear-gradient(160deg, #152033 0%, #0b1220 100%);
  }

  #FloatBenefits-{{ section.id }} .float-benefits__recommend {
    position: absolute;
    left: 1.2rem;
    bottom: 1.2rem;
    right: 1.2rem;
    max-width: 375px;
    padding: 1rem 1rem;
    border-radius: 12px;
    background: color-mix(in srgb, var(--fb-card) 88%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  #FloatBenefits-{{ section.id }} .float-benefits__recommend-label {
    margin: 0 0 0.4rem;
    color: var(--fb-accent);
    font-size: 1.8rem;
    font-weight: 700;
  }

  #FloatBenefits-{{ section.id }} .float-benefits__recommend-text {
    margin: 0;
    color: var(--fb-text);
    font-size: 1.2rem;
    font-weight: 400;
    line-height: 1.45;
  }

  @media screen and (max-width: 989px) {
    #FloatBenefits-{{ section.id }} .float-benefits__inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    #FloatBenefits-{{ section.id }} .float-benefits__media {
      order: -1;
      max-width: 100%;
    }
  }

  @media screen and (max-width: 749px) {
    #FloatBenefits-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    #FloatBenefits-{{ section.id }} .float-benefits__inner {
      padding: 0 2rem;
    }

    #FloatBenefits-{{ section.id }} .float-benefits__heading {
      font-size: var(--fb-heading-size-mobile);
      margin-bottom: 0.8rem;
    }

    #FloatBenefits-{{ section.id }} .float-benefits__description {
      font-size: 16px;
      line-height: 1.6;
    }
    #FloatBenefits-{{ section.id }} .float-benefits__tabs {
      gap: 0.4rem;
    }

    #FloatBenefits-{{ section.id }} .float-benefits__tab {
      min-height: 5.6rem;
      padding: 0.85rem 0.4rem 0.8rem;
      font-size: 1.6rem;
      border-radius: 0.8rem 0.8rem 0 0;
    }

    #FloatBenefits-{{ section.id }} .float-benefits__tab-icon {
      width: 3rem;
      height: 3rem;
    }

    #FloatBenefits-{{ section.id }} .float-benefits__item-icon {
      width: 3.5rem;
      height: 3.5rem;
    }
    #FloatBenefits-{{ section.id }} .float-benefits__item-title {
      font-size: 16px;
    }
    #FloatBenefits-{{ section.id }} .float-benefits__item-icon img,
    #FloatBenefits-{{ section.id }} .float-benefits__item-icon svg {
      width: 2.4rem;
      height: 2.4rem;
    }
    #FloatBenefits-{{ section.id }} .float-benefits__recommend {
      left: 1rem;
      right: 1rem;
      bottom: 1rem;
    }
  }
{% endstyle %}

{%- capture icon_check -%}
  <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
    <path d="M3.2 8.2l3 3 6.6-6.8" stroke="#ffffff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
{%- endcapture -%}

{%- capture icon_mind -%}
  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path d="M12 3a6 6 0 0 0-4.5 9.9V16a1.5 1.5 0 0 0 1.5 1.5h6A1.5 1.5 0 0 0 16.5 16v-3.1A6 6 0 0 0 12 3Z" stroke="currentColor" stroke-width="1.6"/>
    <path d="M10 20h4M11 17.5v2.5M13 17.5v2.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
  </svg>
{%- endcapture -%}

{%- capture icon_body -%}
  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <circle cx="12" cy="5" r="2.2" stroke="currentColor" stroke-width="1.6"/>
    <path d="M8.5 10.5h7l-1.2 4.2L16 21M15.5 14.7 12 13.2 8.5 14.7 8 21" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
{%- endcapture -%}

{%- capture icon_performance -%}
  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path d="M4 18V6M4 18h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
    <path d="m7.5 13.5 3.2-3.5 3 2.4L17.5 7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
{%- endcapture -%}

<section
  id="FloatBenefits-{{ section.id }}"
  class="float-benefits"
  data-float-benefits
>
  <div class="page-width float-benefits__inner">
    <div class="float-benefits__content">
      {%- if section.settings.label != blank -%}
        <p class="float-benefits__label">{{ section.settings.label | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank or section.settings.heading_accent != blank -%}
        <h2 class="float-benefits__heading">
          {%- if section.settings.heading != blank -%}
            <span>{{ section.settings.heading | escape }}</span>
          {%- endif -%}
          {%- if section.settings.heading_accent != blank -%}
            <span class="float-benefits__heading-accent"> {{ section.settings.heading_accent | escape }}</span>
          {%- endif -%}
        </h2>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <div class="float-benefits__description rte">
          {{ section.settings.description }}
        </div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="float-benefits__tabs" role="tablist" aria-label="{{ section.settings.label | default: 'Float benefits' | escape }}">
          {%- for block in section.blocks -%}
            <button
              type="button"
              class="float-benefits__tab"
              id="FloatBenefits-{{ section.id }}-tab-{{ block.id }}"
              role="tab"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              aria-controls="FloatBenefits-{{ section.id }}-panel-{{ block.id }}"
              data-float-benefits-tab
              {{ block.shopify_attributes }}
            >
              <span class="float-benefits__tab-icon">
                {%- if block.settings.tab_icon != blank -%}
                  {{
                    block.settings.tab_icon
                    | image_url: width: 64
                    | image_tag: loading: 'lazy', alt: ''
                  }}
                {%- else -%}
                  {%- case block.settings.tab_icon_style -%}
                    {%- when 'body' -%}
                      {{ icon_body }}
                    {%- when 'performance' -%}
                      {{ icon_performance }}
                    {%- else -%}
                      {{ icon_mind }}
                  {%- endcase -%}
                {%- endif -%}
              </span>
              <span>{{ block.settings.tab_title | escape }}</span>
            </button>
          {%- endfor -%}
        </div>

        <div class="float-benefits__panels">
          {%- for block in section.blocks -%}
            <div
              class="float-benefits__panel{% if forloop.first %} is-active{% endif %}"
              id="FloatBenefits-{{ section.id }}-panel-{{ block.id }}"
              role="tabpanel"
              aria-labelledby="FloatBenefits-{{ section.id }}-tab-{{ block.id }}"
              {% unless forloop.first %}hidden{% endunless %}
              data-float-benefits-panel
            >
              <ul class="float-benefits__list">
                {%- for i in (1..3) -%}
                  {%- liquid
                    case i
                      when 1
                        assign benefit_icon = block.settings.benefit_1_icon
                        assign benefit_title = block.settings.benefit_1_title
                        assign benefit_text = block.settings.benefit_1_text
                      when 2
                        assign benefit_icon = block.settings.benefit_2_icon
                        assign benefit_title = block.settings.benefit_2_title
                        assign benefit_text = block.settings.benefit_2_text
                      when 3
                        assign benefit_icon = block.settings.benefit_3_icon
                        assign benefit_title = block.settings.benefit_3_title
                        assign benefit_text = block.settings.benefit_3_text
                    endcase
                  -%}
                  {%- if benefit_title != blank or benefit_text != blank -%}
                    <li class="float-benefits__item">
                      <span class="float-benefits__item-icon">
                        {%- if benefit_icon != blank -%}
                          {{
                            benefit_icon
                            | image_url: width: 64
                            | image_tag: loading: 'lazy', alt: ''
                          }}
                        {%- else -%}
                          {{ icon_check }}
                        {%- endif -%}
                      </span>
                      <div class="float-benefits__item-copy">
                        {%- if benefit_title != blank -%}
                          <h3 class="float-benefits__item-title">{{ benefit_title | escape }}</h3>
                        {%- endif -%}
                        {%- if benefit_text != blank -%}
                          <p class="float-benefits__item-text">{{ benefit_text | escape }}</p>
                        {%- endif -%}
                      </div>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="float-benefits__media">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1400
          | image_tag:
            class: 'float-benefits__image',
            widths: '600, 900, 1200, 1400',
            sizes: '(min-width: 990px) 42vw, 100vw',
            loading: 'lazy'
        }}
      {%- else -%}
        <div class="float-benefits__image-placeholder"></div>
      {%- endif -%}

      {%- if section.settings.show_recommend and section.settings.recommend_text != blank -%}
        <div class="float-benefits__recommend">
          {%- if section.settings.recommend_label != blank -%}
            <p class="float-benefits__recommend-label">{{ section.settings.recommend_label | escape }}</p>
          {%- endif -%}
          <p class="float-benefits__recommend-text">{{ section.settings.recommend_text | escape }}</p>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('FloatBenefits-{{ section.id }}');
    if (!root) return;

    var tabs = Array.prototype.slice.call(root.querySelectorAll('[data-float-benefits-tab]'));
    var panels = Array.prototype.slice.call(root.querySelectorAll('[data-float-benefits-panel]'));
    if (!tabs.length || !panels.length) return;

    function activate(index) {
      tabs.forEach(function (tab, i) {
        var selected = i === index;
        tab.setAttribute('aria-selected', selected ? 'true' : 'false');
        tab.tabIndex = selected ? 0 : -1;
      });

      panels.forEach(function (panel, i) {
        var active = i === index;
        panel.classList.toggle('is-active', active);
        if (active) {
          panel.removeAttribute('hidden');
        } else {
          panel.setAttribute('hidden', '');
        }
      });
    }

    tabs.forEach(function (tab, index) {
      tab.addEventListener('click', function () {
        activate(index);
      });

      tab.addEventListener('keydown', function (event) {
        var nextIndex = index;
        if (event.key === 'ArrowRight') nextIndex = (index + 1) % tabs.length;
        if (event.key === 'ArrowLeft') nextIndex = (index - 1 + tabs.length) % tabs.length;
        if (event.key === 'Home') nextIndex = 0;
        if (event.key === 'End') nextIndex = tabs.length - 1;
        if (nextIndex !== index) {
          event.preventDefault();
          activate(nextIndex);
          tabs[nextIndex].focus();
        }
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Float Benefits",
  "tag": "section",
  "class": "section-float-benefits",
  "max_blocks": 3,
  "settings": [
    {
      "type": "header",
