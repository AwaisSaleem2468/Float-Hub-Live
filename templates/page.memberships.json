    "custom_section_testimonial_ew4ECx": {
      "type": "custom-section-testimonial",
      "blocks": {
        "testimonial_dtNNXb": {
          "type": "testimonial",
          "settings": {
            "image": "shopify://shop_images/Screen-Shot-2019-07-10-at-4.46.55-PM-300x296.jpg",
            "review_title": "The most relaxing hour of my year so far!",
            "review_text": "This experience is honestly not to be underestimated - I was in so much pain from a gym session... and it wiped away all my pain in that hour alone! p.s. it’s not claustrophobic at all, I’ll be back!",
            "name": "Elizabeth S.",
            "designation": "TripAdvisor"
          }
        },
        "testimonial_UKpATV": {
          "type": "testimonial",
          "settings": {
            "image": "shopify://shop_images/Screen-Shot-2019-07-10-at-4.18.45-PM.png",
            "review_title": "Cannot recommend this place enough.",
            "review_text": "For anyone that is sitting on the fence about this kind of Therapy. I suffer from insomnia, depression and anxiety. This is goal changing for me and thats after ONE session. I will be back. Frequently.",
            "name": "Wayne Gibbons",
            "designation": "Facebook"
          }
        },
        "testimonial_RMMxmq": {
          "type": "testimonial",
          "disabled": true,
          "settings": {
            "image": "shopify://shop_images/avatar008.jpg",
            "review_title": "My first float, but definitely not my last.",
            "review_text": "I wasn’t really sure what to expect but it had been highly recommended by a friend so I thought I’d give it a go - I’m glad I did. I left feeling completely relaxed and really set up for the week ahead. It was the perfect opportunity to switch off from everything and recharge",
            "name": "Andrew",
            "designation": "TripAdvisor"
          }
        },
        "testimonial_MEhWJg": {
          "type": "testimonial",
          "settings": {
            "image": "shopify://shop_images/Screenshot-2022-08-31-at-14.35.16-300x268.png",
            "review_title": "One of my favourite ways to bring myself into a parasympathetic state, is to do an evening float therapy session.",
            "review_text": "The magnesium salts, restful position of my body, and focusing on my breath all help my body and mind to relax. Combining this with some yoga poses, and writing down my thoughts, can really help me get a good sleep.\"",
            "name": "Charlie Tunmore",
            "designation": ""
          }
        },
        "testimonial_8gptHb": {
          "type": "testimonial",
          "settings": {
            "image": "shopify://shop_images/11222227_10152970901417396_9044583712647267181_n.jpg",
            "review_title": "I've used floatation for over 10 years",
            "review_text": "For relaxation and as a reset, it was great to try out such a lovely new space. The tanks were fabulous and spacious, and the facility was beautifully designed. Looking forward to coming back again soon.",
            "name": "Beccy Reese",
            "designation": "Facebook"
          }
        },
        "testimonial_LpBJBD": {
          "type": "testimonial",
          "settings": {
            "image": "shopify://shop_images/avatar059.jpg",
            "review_title": "It’s like floating in space!",
            "review_text": "This is amazing! So relaxing. Very friendly and helpful staff - Tony was very knowledgable and put me at ease. I would highly recommend this.",
            "name": "Louise",
            "designation": "TripAdvisor"
          }
        },
        "testimonial_JrQ89F": {
          "type": "testimonial",
          "settings": {
            "image": "shopify://shop_images/Screen-Shot-2019-07-11-at-8.06.14-PM-245x300.png",
            "review_title": "An Absolute Dream",
            "review_text": "If you've never tried this before, you really should. A total dream from start to finish. The staff are attentive, the decor is high-end and looks great, the vibe is super chilled, and you hear nothing from the busy streets above you. I had never done anything like it before. I felt safe and warm and completely at peace. My lower back felt great (which is very rare).",
            "name": "Christopher",
            "designation": "TripAdvisor"
          }
        },
        "testimonial_3pzkME": {
          "type": "testimonial",
          "settings": {
            "image": "shopify://shop_images/14991347_10157759337275158_2328856854046519928_o-225x300.jpg",
            "review_title": "I felt my anxiety melt away I",
            "review_text": "I had never tried floating before, but it was an incredible experience. I left feeling completely relaxed and reinvigorated. The staff were wonderful and helpful, the facilities were clean and luxurious, and the floatation pods were state of the art.",
            "name": "J Sergio Del Guidici",
            "designation": "Facebook"
          }
        },
        "testimonial_7mRKDJ": {
          "type": "testimonial",
          "settings": {
            "image": "shopify://shop_images/avatar050-300x300.jpg",
            "review_title": "I highly recommend it.",
            "review_text": "This was my first float experience. I found it very interesting and very relaxing. The float equipment is obviously brand new and of first class quality. I did not quite drift off to sleep, but was on the brink. I think that, on a second trip, I would slip into the zone more easily! I have practised meditation in the past (but over 10 years ago) and found that I was able to remember some simply breathing techniques to help me relax.",
            "name": "Rob",
            "designation": "TripAdvisor"
          }
        },
        "testimonial_c4MN8J": {
          "type": "testimonial",
          "settings": {
            "image": "shopify://shop_images/avatar059.jpg",
            "review_title": "From the moment you enter, a sense of calm and quiet descends over you.",
            "review_text": "This is embodied by the chic and simple surroundings which promote a sense of wellness and relaxation. The facilities were clean and new and the team looked after my friend and I amazingly. I would relish the opportunity to go back again, making a floating tank a regular part of my wellness regime. I came away feeling as though I'd spent all day in a spa!",
            "name": "Fabian H.",
            "designation": "TripAdvisor"
          }
        },
        "testimonial_KHwVrL": {
          "type": "testimonial",
          "settings": {
            "image": "shopify://shop_images/avatar055-300x300.jpg",
            "review_title": "It’s definitely a place I would recommend everyone to visit!",
            "review_text": "The actual float for me was a positive sensorial challenge, and it opened a personal depth which allowed for deep meditation and self-knowledge. I also liked that, from the moment I stepped through the door until the end, each step of the process was mindfully considered.",
            "name": "Patricia",
            "designation": "TripAdvisor"
          }
        },
        "testimonial_8DDT6z": {
          "type": "testimonial",
          "settings": {
            "image": "shopify://shop_images/Screenshot-2022-07-27-at-13.39.26-300x285.png",
            "review_title": "I had a fantastic experience.",
            "review_text": "The session was super relaxing and I felt I could let go of tensions and stress. The stuff is very friendly and helpful. The facility is clean and comfortable. I highly recommend it.”",
            "name": "Francesco Gatti",
            "designation": "TripAMeditation & Lifestyle expert, author and co-founder of Blissdvisor"
          }
        }
      },
