    "collapsible_content_NAMghC": {
      "type": "collapsible-content",
      "blocks": {
        "collapsible_row_qQLipP": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How do I manage my account?",
            "icon": "none",
            "row_content": "<p>Click book now and you can choose the availability for your float.</p><p>You will also see Account option so you can log in with your username and password.</p><p>Once into your account click ” ME” to manage your account and to see all your history.</p>",
            "page": ""
          }
        },
        "collapsible_row_Tyb7Wx": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How do update the credit card on my account?",
            "icon": "none",
            "row_content": "<p>If you wish to update a credit or debit card on your account,  log in to your account and scroll down. You will find an option to update the credit or debit card. Or call us and we will update it for you.</p>",
            "page": ""
          }
        },
        "collapsible_row_YbTHbc": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How do I cancel my membership?",
            "icon": "none",
            "row_content": "<p>You can cancel your membership at any time. We kindly ask that you provide at least 10 days’ notice before your next payment is due.</p><p>To cancel, please email: <a><strong>manager@floathub.co.uk</strong></a>.</p><p>Please note: we do not accept membership cancellations via telephone.</p><p>All remaining sessions will expire 30 days after your membership is cancelled.</p>",
            "page": ""
          }
        },
        "collapsible_row_CYyTzU": {
          "type": "collapsible_row",
          "settings": {
            "heading": "When do membership payments get charged?",
            "icon": "none",
            "row_content": "<p>Membership payments are made every 30 days based on when you signed up. Every month provides you with one float session credit on your account which rolls over for up to 12 months and can be used at any time as long as your membership is active.</p><p>You can change the autopay date simply email us to: team@floathub.co.uk</p>",
            "page": ""
          }
        },
        "collapsible_row_kLCgna": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Can I pause/freeze my membership?",
            "icon": "none",
            "row_content": "<p>Yes you can pause/freeze your membership from 1 to 3 months per each calendar year.</p><p>You can change the autopay date simply email us to: team@floathub.co.uk.</p>",
            "page": ""
          }
        },
        "collapsible_row_GAwx8k": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Why didn't I get a booking confirmation?",
            "icon": "none",
            "row_content": "<p>Either the email address on your file is incorrect, or we don’t have your email on file or,  you opted out of receiving schedule reminders and appointment updates. To change your registered email address, or opt back into these emails, log in to your account and update it or send an email to <a href=\"mailto:team@floathub.co.uk\" target=\"_blank\">team@floathub.co.uk </a></p><p>Simply login to your account and click ” ME” to update any detail on your account, like email, telephone number, credit card details, etc.</p>",
            "page": ""
          }
        },
        "collapsible_row_gKcCe8": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Can I have a VAT receipt?",
            "icon": "none",
            "row_content": "<p>Absolutely. Please let us know if you need one, and we will arrange it for you.</p>",
            "page": ""
          }
        }
      },
