    "collapsible_content_7y8TFD": {
      "type": "collapsible-content",
      "blocks": {
        "collapsible_row_GkJa8q": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Can I share my floats or membership?",
            "icon": "none",
            "row_content": "<p>Our memberships are individual, however you earn free floats by referring new members, previous unused floats can be gifted, members can buy discounted guest passes, and also get 20% off any packs we might offer from time to time.</p>",
            "page": ""
          }
        },
        "collapsible_row_pNAhXE": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Do float credits ever expire?",
            "icon": "none",
            "row_content": "<p>No, floats on your account rollover and never expire for single float purchases or active members.</p>",
            "page": ""
          }
        },
        "collapsible_row_GNmjGm": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What if I want to float more than once a month?",
            "icon": "none",
            "row_content": "<p>The best option is to sign up for our membership <strong>(every 4th float within a calendar month is free!),</strong> which gives you the best price on floats, additional floats at the same price, and many additional perks.</p>",
            "page": ""
          }
        },
        "collapsible_row_Q8qmTF": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Do I have to buy a float before booking an appointment?",
            "icon": "none",
            "row_content": "<p>Yes, if you are not currently a member, you will need to first purchase a float session that you can put towards your appointment that you will be booking. Active members are able to pre-book appointments and can set up recurring times to help build your floating practice.</p>",
            "page": ""
          }
        },
        "collapsible_row_QNyGti": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Is there any commitment, sign up, or cancellation fee for membership?",
            "icon": "none",
            "row_content": "<p>No, our memberships are flexible and month-to-month. There is no sign up or cancellation fee to become a member. There is no minimum term and if you wish to cancel we require a written request to team@floathub.co.uk 10 days before the payment is due.</p>",
            "page": ""
          }
        },
        "collapsible_row_dqzEdk": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What's your refund policy?",
            "icon": "none",
            "row_content": "<p><strong>We do offer full refund within 14 days from the purchase.</strong></p><p>Refunds are available within 14 days of purchase, if the sessions have not been used. If you need a refund for any reason, please get in touch and we can help you with this.</p>",
            "page": ""
          }
        }
      },
      "block_order": [
        "collapsible_row_GkJa8q",
